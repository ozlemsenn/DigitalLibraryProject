@using DigitalLibrary.Models
@model IEnumerable<Users>

@{
    ViewBag.Title = "Kullanıcı Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    int aktifKullaniciID = Session["UserID"] != null ? Convert.ToInt32(Session["UserID"]) : 0;
}

<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css" rel="stylesheet" />

<style>
    .premium-card {
        border-radius: 12px;
        border: 1px solid #F0EAE1;
        background-color: #FFFFFF;
        box-shadow: 0 4px 15px rgba(92, 64, 51, 0.03);
    }

    .modern-table {
        table-layout: auto;
    }

        .modern-table th {
            border-top: none;
            border-bottom: 2px solid #F0EAE1;
            color: #7F736A;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .modern-table td {
            vertical-align: middle;
            border-bottom: 1px solid #F0EAE1;
            color: #2C1E16;
            font-weight: 500;
        }

        .modern-table tr:hover td {
            background-color: #FDFCFB;
        }

        .modern-table th:last-child,
        .modern-table td:last-child {
            white-space: nowrap;
            min-width: 150px;
        }

    .actions-wrapper {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .badge-admin {
        background-color: #C0392B;
        color: white;
        padding: 5px 10px;
        border-radius: 6px;
        white-space: nowrap;
        font-size: 0.85rem;
    }

    .badge-personel {
        background-color: #F0EAE1;
        color: #5C4033;
        padding: 5px 10px;
        border-radius: 6px;
        white-space: nowrap;
        font-size: 0.85rem;
    }

    .status-active {
        color: #27ae60;
        font-weight: 600;
        white-space: nowrap;
        background-color: #e8f8f5;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.8rem;
    }

    .status-passive {
        color: #e74c3c;
        font-weight: 600;
        white-space: nowrap;
        background-color: #FDF3F2;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.8rem;
    }

    .btn-action {
        width: 32px;
        height: 32px;
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: 0.2s;
        border: none;
    }

    .btn-action-edit {
        background-color: #F0EAE1;
        color: #5C4033;
    }

        .btn-action-edit:hover {
            background-color: #5C4033;
            color: white;
        }

    .btn-action-delete {
        background-color: #FDF3F2;
        color: #C0392B;
    }

        .btn-action-delete:hover {
            background-color: #C0392B;
            color: white;
        }

    .dataTables_wrapper {
        padding-top: 2px;
    }

    div.dataTables_wrapper div.dataTables_filter {
        margin-bottom: 22px;
        text-align: right;
    }

        div.dataTables_wrapper div.dataTables_filter label {
            display: inline-flex;
            align-items: center;
            color: #7F736A;
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 0;
        }

        div.dataTables_wrapper div.dataTables_filter input {
            border-radius: 50px;
            border: 1px solid #F0EAE1;
            background-color: #FCFAF7;
            padding: 8px 16px 8px 38px;
            margin-left: 10px;
            min-width: 240px;
            font-size: 0.9rem;
            color: #2C1E16;
            box-shadow: none;
            outline: none;
            transition: 0.2s ease;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' fill='%237F736A' viewBox='0 0 16 16'><path d='M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z'/></svg>");
            background-repeat: no-repeat;
            background-position: 14px center;
            background-size: 14px;
        }

            div.dataTables_wrapper div.dataTables_filter input:focus {
                border-color: #C0392B;
                background-color: #FFFFFF;
                box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.08);
            }

            div.dataTables_wrapper div.dataTables_filter input::placeholder {
                color: #B9AFA6;
            }

    div.dataTables_wrapper div.dataTables_info {
        color: #7F736A;
        font-size: 0.85rem;
        padding-top: 12px;
    }

    .page-item.active .page-link {
        background-color: #C0392B !important;
        border-color: #C0392B !important;
        color: white !important;
    }

    .page-link {
        color: #5C4033;
        border-color: #F0EAE1;
        border-radius: 6px !important;
        margin: 0 2px;
    }

        .page-link:hover {
            background-color: #FDF3F2;
            color: #C0392B;
        }

    .password-container {
        position: relative;
    }

    .password-toggle {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #7F736A;
        z-index: 10;
    }

    .filter-bar {
        background-color: #FCF9F5;
        border: 1px solid #F0EAE1;
        border-radius: 10px;
        padding: 15px 20px;
        margin-bottom: 20px;
    }

    .status-btn {
        background-color: white;
        color: #7F736A;
        border: 1px solid #F0EAE1;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 8px 16px;
        transition: 0.2s;
    }

        .status-btn:hover {
            background-color: #FDF3F2;
            color: #C0392B;
        }

        .status-btn.active {
            background-color: #C0392B;
            color: white;
            border-color: #C0392B;
        }

    .filter-select {
        border-radius: 8px;
        border: 1px solid #F0EAE1;
        color: #2C1E16;
        font-weight: 500;
        font-size: 0.9rem;
        padding: 8px 12px;
        outline: none;
        box-shadow: none;
        cursor: pointer;
    }

        .filter-select:focus {
            border-color: #C0392B;
        }

    .btn-details-trigger {
        transition: 0.2s;
    }

        .btn-details-trigger:hover {
            background-color: #D35400 !important;
            color: white !important;
            border-color: #D35400 !important;
            transform: scale(1.1);
        }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="font-weight-bold mb-1" style="color: #2C1E16;">Sistem Kullanıcıları</h4>
        <p class="mb-0" style="color: #7F736A;">Tüm personelleri, yöneticileri ve departmanlarını buradan yönetin.</p>
    </div>
    <button class="btn font-weight-bold shadow-sm" data-toggle="modal" data-target="#userModal" style="background-color: #C0392B; color: white; border-radius: 8px; padding: 10px 20px;">
        <i class="fas fa-user-plus mr-2"></i> Yeni Personel Ekle
    </button>
</div>

<div class="filter-bar d-flex flex-wrap justify-content-between align-items-center shadow-sm">
    <div class="btn-group" role="group" id="statusFilterGroup">
        <button type="button" class="btn status-btn active" data-filter="">Tümü</button>
        <button type="button" class="btn status-btn" data-filter="Aktif">Sadece Aktifler</button>
        <button type="button" class="btn status-btn" data-filter="Pasif">Pasif Personel</button>
    </div>

    <div class="d-flex align-items-center mt-3 mt-md-0">
        <label class="mb-0 mr-2 font-weight-bold" style="color: #7F736A; font-size: 0.9rem;"><i class="fas fa-filter mr-1"></i> Departman:</label>
        <select id="departmentFilter" class="form-control filter-select" style="width: 200px;">
            <option value="">Tüm Departmanlar</option>
            <option value="Bilgi İşlem (IT)">Bilgi İşlem (IT)</option>
            <option value="İnsan Kaynakları">İnsan Kaynakları</option>
            <option value="Muhasebe & Finans">Muhasebe & Finans</option>
            <option value="Satış & Pazarlama">Satış & Pazarlama</option>
            <option value="Operasyon">Operasyon</option>
            <option value="Hukuk">Hukuk</option>
            <option value="Üst Yönetim">Üst Yönetim</option>
            <option value="Diğer">Diğer</option>
        </select>
    </div>
</div>

<div class="card premium-card">
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table modern-table mb-0 w-100" id="usersTable">
                <thead>
                    <tr>
                        <th class="pl-4">Ad Soyad</th>
                        <th>Email Adresi</th>
                        <th>Departman</th>
                        <th>Rol (Yetki)</th>
                        <th>Durum</th>
                        <th class="text-right pr-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td class="pl-4">
                                    <div class="d-flex align-items-center">
                                        <div class="mr-3 shadow-sm" style="width: 40px; height: 40px; border-radius: 50%; background: #FDF3F2; display: flex; align-items: center; justify-content: center; color: #C0392B; font-weight: bold; flex: 0 0 auto; border: 1px solid #fae3db;">
                                            @user.Name.Substring(0, 1).ToUpper()
                                        </div>
                                        <span class="font-weight-bold mr-2" style="font-size: 1.05rem;">@user.Name</span>

                                        <button class="btn btn-sm btn-light rounded-circle btn-details-trigger shadow-sm" data-id="@user.ID" title="Detayları Gör" style="width: 26px; height: 26px; padding: 0; color: #7F736A; border: 1px solid #F0EAE1;">
                                            <i class="fas fa-eye" style="font-size: 0.7rem;"></i>
                                        </button>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td class="dept-cell">
                                    @if (!string.IsNullOrEmpty(user.Department))
                                    {
                                        <span style="color: #7F736A; font-weight: 500;"><i class="fas fa-building mr-1 text-muted"></i> @user.Department</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge-admin"><i class="fas fa-crown mr-1"></i> Yönetici</span>
                                    }
                                    else
                                    {
                                        <span class="badge-personel"><i class="fas fa-user mr-1"></i> Personel</span>
                                    }
                                </td>
                                <td class="status-cell">
                                    @if (user.IsActive)
                                    {
                                        <span class="status-active"><i class="fas fa-check-circle mr-1"></i> Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="status-passive"><i class="fas fa-minus-circle mr-1"></i> Pasif</span>
                                    }
                                </td>
                                <td class="text-right pr-4">
                                    <div class="actions-wrapper">

                                        @if (user.Role == "Admin" && user.ID != aktifKullaniciID)
                                        {
                                            <span class="badge badge-light text-muted p-2" style="border: 1px solid #F0EAE1;" title="Diğer yöneticilere müdahale edemezsiniz">
                                                <i class="fas fa-shield-alt mr-1"></i> Yetki Koruması
                                            </span>
                                        }
                                        else
                                        {
                                            <button class="btn-action btn-action-edit" title="Düzenle" data-id="@user.ID"><i class="fas fa-pen"></i></button>

                                            if (user.ID != aktifKullaniciID)
                                            {
                                                if (user.IsActive)
                                                {
                                                    <button class="btn-action btn-action-toggle" title="Pasife Al (Erişimi Kes)" data-id="@user.ID" data-status="false" style="background-color: #FDF3F2; color: #C0392B;">
                                                        <i class="fas fa-user-slash"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn-action btn-action-toggle" title="Aktifleştir (Erişim Ver)" data-id="@user.ID" data-status="true" style="background-color: #e8f8f5; color: #27ae60;">
                                                        <i class="fas fa-user-check"></i>
                                                    </button>
                                                }
                                                <button class="btn-action btn-action-delete" title="Kalıcı Sil" data-id="@user.ID"><i class="fas fa-trash"></i></button>
                                            }
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="userModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <div class="modal-header" style="background-color: #FCF9F5; border-bottom: 1px solid #F0EAE1; border-radius: 15px 15px 0 0;">
                <h5 class="modal-title font-weight-bold" style="color: #2C1E16;"><i class="fas fa-user-plus mr-2" style="color: #C0392B;"></i> Personel Bilgileri</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body p-4">
                <form id="userForm">
                    <input type="hidden" id="UserID" value="" />

                    <div class="form-group">
                        <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Ad Soyad <span class="text-danger">*</span></label>
                        <input type="text" id="Name" class="form-control" placeholder="Örn: Mehmet Yılmaz" style="border-radius: 8px; border: 1px solid #F0EAE1;" required>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Email Adresi <span class="text-danger">*</span></label>
                            <input type="email" id="Email" class="form-control" placeholder="ornek@sirket.com" style="border-radius: 8px; border: 1px solid #F0EAE1;" required>
                        </div>
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Departman</label>
                            <select id="Department" class="form-control" style="border-radius: 8px; border: 1px solid #F0EAE1;">
                                <option value="">-- Departman Seçin --</option>
                                <option value="Bilgi İşlem (IT)">Bilgi İşlem (IT)</option>
                                <option value="İnsan Kaynakları">İnsan Kaynakları</option>
                                <option value="Muhasebe & Finans">Muhasebe & Finans</option>
                                <option value="Satış & Pazarlama">Satış & Pazarlama</option>
                                <option value="Operasyon">Operasyon</option>
                                <option value="Hukuk">Hukuk</option>
                                <option value="Üst Yönetim">Üst Yönetim</option>
                                <option value="Diğer">Diğer</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Şifre (Geçici) <span class="text-danger">*</span></label>
                            <div class="password-container">
                                <input type="password" id="Password" class="form-control" placeholder="******" style="border-radius: 8px; border: 1px solid #F0EAE1; padding-right: 35px;" required>
                                <i class="fas fa-eye password-toggle" id="togglePassword"></i>
                            </div>
                        </div>
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Sistem Rolü <span class="text-danger">*</span></label>
                            <select id="Role" class="form-control" style="border-radius: 8px; border: 1px solid #F0EAE1;" required>
                                <option value="Personel">Standart Personel</option>
                                <option value="Admin">Yönetici (Admin)</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group mt-3" id="pasifNedeniAlani" style="display: none;">
                        <label class="font-weight-bold" style="color: #C0392B; font-size: 0.9rem;">
                            <i class="fas fa-exclamation-circle mr-1"></i> Pasife Alınma Nedeni
                        </label>
                        <textarea id="DeactivationReasonDisplay" class="form-control" readonly rows="2" style="border-radius: 8px; border: 1px solid #FDF3F2; background-color: #FDF3F2; color: #C0392B;"></textarea>
                    </div>

                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light font-weight-bold" data-dismiss="modal" style="border-radius: 8px;">İptal</button>
                <button type="button" id="btnKaydet" class="btn font-weight-bold shadow-sm" style="background-color: #C0392B; color: white; border-radius: 8px;">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="userDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <div class="modal-header" style="background-color: #FCF9F5; border-bottom: 1px solid #F0EAE1; border-radius: 15px 15px 0 0;">
                <h5 class="modal-title font-weight-bold" style="color: #2C1E16;"><i class="fas fa-address-card mr-2" style="color: #D35400;"></i> Personel Detayları</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body p-4 text-center">
                <div id="DetailInitial" class="mx-auto shadow-sm mb-3" style="width: 70px; height: 70px; border-radius: 50%; background: #FDF3F2; display: flex; align-items: center; justify-content: center; color: #C0392B; font-weight: bold; font-size: 1.8rem; border: 2px solid #fae3db;">
                </div>
                <h4 class="font-weight-bold mb-1" id="DetailName" style="color: #2C1E16;">-</h4>
                <p class="text-muted mb-4" id="DetailRole" style="font-size: 0.95rem;">-</p>

                <div class="text-left bg-light p-3 shadow-sm" style="border-radius: 10px; border: 1px solid #F0EAE1;">
                    <p class="mb-2"><i class="fas fa-envelope mr-2" style="color: #7F736A; width: 16px;"></i> <strong style="color: #5C4033;">E-Posta:</strong> <span id="DetailEmail" class="text-muted float-right">-</span></p>
                    <hr style="margin: 8px 0; border-color: #E5DCD3;">
                    <p class="mb-2"><i class="fas fa-building mr-2" style="color: #7F736A; width: 16px;"></i> <strong style="color: #5C4033;">Departman:</strong> <span id="DetailDepartment" class="text-muted float-right">-</span></p>
                    <hr style="margin: 8px 0; border-color: #E5DCD3;">
                    <p class="mb-0"><i class="fas fa-info-circle mr-2" style="color: #7F736A; width: 16px;"></i> <strong style="color: #5C4033;">Durum:</strong> <span id="DetailStatus" class="float-right">-</span></p>
                </div>

                <div id="DetailReasonArea" class="mt-3 p-3 text-left shadow-sm" style="display: none; background-color: #FDF3F2; border: 1px solid #fae3db; border-radius: 10px;">
                    <p class="mb-1 font-weight-bold" style="color: #C0392B;"><i class="fas fa-exclamation-triangle mr-1"></i> Pasife Alınma Nedeni:</p>
                    <p class="mb-0 text-muted" id="DetailReasonText" style="font-size: 0.9rem;">-</p>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 justify-content-center mt-2">
                <button type="button" class="btn btn-light font-weight-bold px-5" data-dismiss="modal" style="border-radius: 8px; border: 1px solid #F0EAE1;">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js"></script>

    <script>
        $(document).ready(function () {

            var table = $('#usersTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json"
                },
                "pageLength": 10,
                "lengthChange": false,
                "ordering": true,
                "info": true,
                "responsive": true,
                "columnDefs": [
                    { "orderable": false, "targets": 5 },
                    { "width": "150px", "targets": 5 }
                ]
            });

            $('.status-btn').on('click', function () {
                $('.status-btn').removeClass('active');
                $(this).addClass('active');

                var filterValue = $(this).data('filter');
                if (filterValue) {
                    table.column(4).search(filterValue).draw();
                } else {
                    table.column(4).search('').draw();
                }
            });

            $('#departmentFilter').on('change', function () {
                var filterValue = $(this).val();
                if (filterValue) {
                    table.column(2).search(filterValue).draw();
                } else {
                    table.column(2).search('').draw();
                }
            });

            $("#togglePassword").click(function () {
                var passInput = $("#Password");
                if (passInput.attr("type") === "password") {
                    passInput.attr("type", "text");
                    $(this).removeClass("fa-eye").addClass("fa-eye-slash");
                } else {
                    passInput.attr("type", "password");
                    $(this).removeClass("fa-eye-slash").addClass("fa-eye");
                }
            });

            $('#usersTable tbody').on('click', '.btn-details-trigger', function () {
                var userId = $(this).data("id");

                $.ajax({
                    url: '/Admin/GetUser/' + userId,
                    type: 'GET',
                    success: function (user) {
                        $("#DetailInitial").text(user.Name.substring(0, 1).toUpperCase());
                        $("#DetailName").text(user.Name);
                        $("#DetailRole").html(user.Role == "Admin" ? '<i class="fas fa-crown text-danger"></i> Sistem Yöneticisi' : '<i class="fas fa-user text-muted"></i> Standart Personel');
                        $("#DetailEmail").text(user.Email);
                        $("#DetailDepartment").text(user.Department ? user.Department : "Atanmamış");

                        if (!user.DeactivationReason || user.DeactivationReason.trim() === "") {
                            $("#DetailStatus").html('<span class="status-active"><i class="fas fa-check-circle mr-1"></i> Aktif</span>');
                            $("#DetailReasonArea").hide();
                        } else {
                            $("#DetailStatus").html('<span class="status-passive"><i class="fas fa-minus-circle mr-1"></i> Pasif</span>');
                            $("#DetailReasonText").text(user.DeactivationReason);
                            $("#DetailReasonArea").slideDown();
                        }

                        $("#userDetailsModal").modal('show');
                    },
                    error: function () {
                        Swal.fire('Hata!', 'Personel detayları alınamadı.', 'error');
                    }
                });
            });

            $("[data-target='#userModal']").click(function () {
                $("#userForm")[0].reset();
                $("#UserID").val("");
                $("#Department").val("");
                $("#Password").attr("type", "password");
                $("#togglePassword").removeClass("fa-eye-slash").addClass("fa-eye");
                $("#pasifNedeniAlani").hide();
                $(".modal-title").html('<i class="fas fa-user-plus mr-2" style="color: #C0392B;"></i> Personel Ekle');
            });

            $('#usersTable tbody').on('click', '.btn-action-toggle', function () {
                var userId = $(this).data("id");
                var isAktiflesecek = $(this).data("status");

                if (!isAktiflesecek) {
                    Swal.fire({
                        title: 'Pasife Alma Nedeni',
                        text: "Lütfen bu personeli neden pasife aldığınızı belirtin:",
                        input: 'textarea',
                        inputPlaceholder: 'Örn: İşten ayrıldı, departman değiştirdi...',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#C0392B',
                        cancelButtonColor: '#7F736A',
                        confirmButtonText: 'Evet, Pasife Al',
                        cancelButtonText: 'İptal',
                        inputValidator: (value) => {
                            if (!value) {
                                return 'Sistem logları için bir neden girmek zorunludur!'
                            }
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $.ajax({
                                url: '/Admin/ToggleUserStatus',
                                type: 'POST',
                                data: { id: userId, reason: result.value },
                                success: function (gelenCevap) {
                                    if (gelenCevap.success) {
                                        Swal.fire('Başarılı!', gelenCevap.message, 'success').then(() => location.reload());
                                    } else {
                                        Swal.fire('Hata!', gelenCevap.message, 'error');
                                    }
                                }
                            });
                        }
                    });
                } else {
                    Swal.fire({
                        title: 'Emin misiniz?',
                        text: "Bu personelin hesabını tekrar aktif hale getirmek istiyor musunuz?",
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#27ae60',
                        cancelButtonColor: '#7F736A',
                        confirmButtonText: 'Evet, Aktifleştir',
                        cancelButtonText: 'İptal'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $.ajax({
                                url: '/Admin/ToggleUserStatus',
                                type: 'POST',
                                data: { id: userId, reason: "" },
                                success: function (gelenCevap) {
                                    if (gelenCevap.success) {
                                        Swal.fire('Başarılı!', gelenCevap.message, 'success').then(() => location.reload());
                                    } else {
                                        Swal.fire('Hata!', gelenCevap.message, 'error');
                                    }
                                }
                            });
                        }
                    });
                }
            });

            $('#usersTable tbody').on('click', '.btn-action-delete', function () {
                var userId = $(this).data("id");

                Swal.fire({
                    title: 'Emin misiniz?',
                    text: "Bu personeli sistemden kalıcı olarak silmek üzeresiniz!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#C0392B',
                    cancelButtonColor: '#7F736A',
                    confirmButtonText: 'Evet, Sil!',
                    cancelButtonText: 'İptal'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/Admin/DeleteUser/' + userId,
                            type: 'POST',
                            success: function (gelenCevap) {
                                if (gelenCevap.success) {
                                    Swal.fire('Silindi!', gelenCevap.message, 'success').then(() => location.reload());
                                } else {
                                    Swal.fire('Hata!', gelenCevap.message, 'error');
                                }
                            }
                        });
                    }
                });
            });

            $('#usersTable tbody').on('click', '.btn-action-edit', function () {
                var userId = $(this).data("id");

                $.ajax({
                    url: '/Admin/GetUser/' + userId,
                    type: 'GET',
                    success: function (user) {
                        $("#UserID").val(user.ID);
                        $("#Name").val(user.Name);
                        $("#Email").val(user.Email);
                        $("#Password").val(user.Password);
                        $("#Role").val(user.Role);
                        $("#Department").val(user.Department);

                        $("#Password").attr("type", "password");
                        $("#togglePassword").removeClass("fa-eye-slash").addClass("fa-eye");

                        if (user.DeactivationReason) {
                            $("#DeactivationReasonDisplay").val(user.DeactivationReason);
                            $("#pasifNedeniAlani").slideDown();
                        } else {
                            $("#DeactivationReasonDisplay").val("");
                            $("#pasifNedeniAlani").hide();
                        }

                        $(".modal-title").html('<i class="fas fa-user-edit mr-2" style="color: #C0392B;"></i> Personel Düzenle');
                        $("#userModal").modal('show');
                    }
                });
            });

            $("#btnKaydet").click(function () {
                if (!$("#Name").val() || !$("#Email").val() || !$("#Password").val()) {
                    Swal.fire('Eksik Bilgi', 'Lütfen yıldızlı (*) zorunlu alanları doldurun.', 'warning');
                    return;
                }

                var userId = $("#UserID").val();

                var kullaniciVerisi = {
                    Name: $("#Name").val(),
                    Email: $("#Email").val(),
                    Password: $("#Password").val(),
                    Role: $("#Role").val(),
                    Department: $("#Department").val()
                };

                var islemUrl = (!userId) ? '/Admin/AddUser' : '/Admin/EditUser';

                if (userId) {
                    kullaniciVerisi.ID = userId;
                }

                $.ajax({
                    url: islemUrl,
                    type: 'POST',
                    data: kullaniciVerisi,
                    success: function (gelenCevap) {
                        if (gelenCevap.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Başarılı!',
                                text: gelenCevap.message,
                                confirmButtonColor: '#27ae60'
                            }).then(() => location.reload());
                        } else {
                            Swal.fire('Hata!', gelenCevap.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Bağlantı Hatası!', 'Sunucuya ulaşılamadı.', 'error');
                    }
                });
            });

        });
    </script>
}