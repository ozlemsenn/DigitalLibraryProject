@{
    ViewBag.Title = "Yönetici Özeti (Dashboard)";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .premium-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .premium-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(92, 64, 51, 0.15) !important;
        }
</style>

<div class="row">
    <div class="col-12">
        <div class="alert border-0 shadow-sm d-flex align-items-center" style="border-radius: 15px; background-color: #fff; border-left: 5px solid #D35400 !important;">
            <i class="fas fa-crown fa-2x mr-3" style="color: #D35400;"></i>
            <div>
                <h5 class="alert-heading font-weight-bold mb-1" style="color: #5C4033;">Premium Yönetim Paneline Hoş Geldiniz!</h5>
                <p class="mb-0 text-muted">Burası kütüphanenin kalbi. Sol menüyü kullanarak sistemi yönetebilir ve istatistikleri takip edebilirsiniz.</p>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card text-white shadow-sm border-0 premium-hover" style="border-radius: 15px; background: linear-gradient(135deg, #5C4033, #3b2a22);">
            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase mb-1" style="opacity: 0.8; letter-spacing: 1px;">Toplam Doküman</h6>
                    <h2 class="mb-0 font-weight-bold">0</h2>
                </div>
                <i class="fas fa-file-alt fa-3x" style="opacity: 0.2;"></i>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-white shadow-sm border-0 premium-hover" style="border-radius: 15px; background: linear-gradient(135deg, #D35400, #a84300);">
            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase mb-1" style="opacity: 0.8; letter-spacing: 1px;">Sistem Kategorileri</h6>
                    <h2 class="mb-0 font-weight-bold">0</h2>
                </div>
                <i class="fas fa-folder-open fa-3x" style="opacity: 0.2;"></i>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-white shadow-sm border-0 premium-hover" style="border-radius: 15px; background: linear-gradient(135deg, #8c7a6b, #6b5a4d);">
            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase mb-1" style="opacity: 0.8; letter-spacing: 1px;">Son Yüklenen</h6>
                    <h4 class="mb-0 font-weight-bold">Hazırlanıyor...</h4>
                </div>
                <i class="fas fa-clock fa-3x" style="opacity: 0.2;"></i>
            </div>
        </div>
    </div>
</div>