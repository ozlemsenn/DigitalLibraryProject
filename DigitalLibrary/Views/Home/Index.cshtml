@using DigitalLibrary.Models
@model IEnumerable<Categories>

@{
    ViewBag.Title = "Kurumsal Doküman Merkezi";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    :root {
        --wood-dark: #2C1E16;
        --wood-medium: #5C4033;
        --rust: #C0392B;
        --bg-ivory: #FCF9F5;
        --gold: #D48900;
        --hover-bg: #FDF3F2; 
    }

    body {
        background-color: var(--bg-ivory) !important;
    }

    .text-dark-wood {
        color: #2C1E16 !important;
    }

    .text-rust {
        color: #C0392B !important;
    }

    .text-muted-warm {
        color: #7F736A !important;
    }

    .text-gold {
        color: #D48900 !important;
    }

    .premium-card {
        border-radius: 12px;
        border: 1px solid rgba(0,0,0,0.04);
        background-color: #FFFFFF;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03) !important;
    }

    .btn-modern {
        transition: all 0.3s ease;
        border-radius: 8px !important;
        font-size: 0.9rem;
    }

    .btn-modern-download {
        background-color: #FDFCFB;
        color: #C0392B;
        border: 1px solid #EAE3D9;
    }

        .btn-modern-download:hover {
            transform: translateY(-2px);
            background-color: #C0392B;
            color: white !important;
            border-color: #C0392B;
            box-shadow: 0 4px 12px rgba(192, 57, 43, 0.2);
        }
    .custom-tree {
        padding: 15px 12px;
    }

    .tree-parent {
        display: flex;
        align-items: center;
        padding: 12px 15px;
        color: #2C1E16;
        font-weight: 700;
        font-size: 0.95rem; 
        border-radius: 8px;
        transition: all 0.2s ease-in-out;
        text-decoration: none !important;
        cursor: pointer;
        margin-bottom: 6px;
        border: 1px solid transparent;
    }

        .tree-parent:hover {
            background-color: var(--hover-bg);
            color: #C0392B;
            border-color: #fae3db;
            transform: translateX(3px); 
        }

        .tree-parent.active {
            background-color: #C0392B;
            color: white;
            box-shadow: 0 4px 10px rgba(192, 57, 43, 0.2);
        }

            .tree-parent.active .folder-icon,
            .tree-parent.active .ok-ikon {
                color: white !important; 
            }

    .tree-children-container {
        padding-left: 28px;
        margin-left: 18px;
        border-left: 2px dashed #EAE3D9; 
        display: none;
        margin-bottom: 12px;
        margin-top: 4px;
    }

    .tree-child {
        display: block;
        padding: 8px 12px;
        color: #5C4033;
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 6px;
        transition: all 0.2s;
        text-decoration: none !important;
        cursor: pointer;
        position: relative;
        margin-bottom: 2px;
    }

        .tree-child::before {
            content: '';
            position: absolute;
            left: -28px; 
            top: 17px;
            width: 18px;
            border-top: 2px dashed #EAE3D9;
        }

        .tree-child:hover, .tree-child.active {
            background-color: var(--hover-bg);
            color: #C0392B;
            padding-left: 16px; 
        }

    .btn-details-trigger {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background-color: #FDFCFB;
        color: #7F736A;
        border: 1px solid #EAE3D9;
        transition: 0.2s;
        font-size: 0.9rem;
    }

        .btn-details-trigger:hover {
            background-color: #5C4033;
            color: white;
            border-color: #5C4033;
        }

    .badge-personal {
        background-color: #e8f0fe;
        color: #2980b9;
        border: 1px solid #d6eaf8;
        padding: 3px 8px;
        font-size: 0.7rem;
        border-radius: 6px;
        font-weight: 600;
        margin-left: 10px;
    }
</style>

<div class="container-fluid px-md-5 mt-4">

    <div class="row mb-4">
        <div class="col-12">
            <h3 class="font-weight-bold text-dark-wood mb-1"><i class="fas fa-layer-group text-rust mr-2"></i> Doküman Merkezi</h3>
            <p class="text-muted-warm" style="font-size: 0.95rem;">Aradığınız şirket içi form, prosedür veya dokümana anında ulaşın.</p>
        </div>
    </div>

    <div class="row">

        <div class="col-lg-3 col-md-4 mb-4">
            <div class="card premium-card sticky-top" style="top: 15px;">
                <div class="card-body custom-tree p-2">

                    <a href="/Home/Index" class="tree-parent active" style="margin-bottom: 10px; border: 1px solid #F0EAE1;">
                        <i class="fas fa-home text-rust mr-2"></i> Tüm Dokümanlar
                    </a>

                    <div style="font-size: 0.7rem; color: #bcaaa4; text-transform: uppercase; letter-spacing: 1px; font-weight: bold; margin: 10px 0 5px 8px;">
                        Kütüphane
                    </div>

                    @foreach (var anaKategori in Model.Where(k => k.ParentID == null))
                    {
                        var altKategoriler = Model.Where(k => k.ParentID == anaKategori.ID).ToList();

                        <div class="tree-node">
                            <a class="tree-parent" data-id="@anaKategori.ID">
                                <i class="fas fa-folder text-gold mr-2 folder-icon"></i> @anaKategori.Name
                                @if (altKategoriler.Any())
                                {
                                    <i class="fas fa-chevron-right float-right mt-1 ok-ikon" style="font-size: 0.6rem; color: #bcaaa4;"></i>
                                }
                            </a>

                            @if (altKategoriler.Any())
                            {
                                <div class="tree-children-container" id="kategoriMenu_@anaKategori.ID">
                                    @foreach (var altKategori in altKategoriler)
                                    {
                                        <a class="tree-child" data-id="@altKategori.ID">
                                            @altKategori.Name
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-9 col-md-8">

            <div class="row mb-4">
                <div class="col-lg-6 col-md-12 mb-3 mb-lg-0">
                    <div class="input-group shadow-sm" style="border-radius: 10px; overflow: hidden; background: white; border: 1px solid #F0EAE1;">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-transparent border-0 text-rust pl-3 pt-2"><i class="fas fa-search"></i></span>
                        </div>
                        <input type="text" class="form-control border-0 py-2 font-weight-bold text-dark-wood" id="searchInput" placeholder="İhtiyacınız olan dokümanı arayın..." style="box-shadow: none; font-size: 0.95rem; outline: none; height: 45px;">
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 mb-3 mb-md-0">
                    <select id="fileTypeFilter" class="form-control shadow-sm w-100" style="border-radius: 10px; border: 1px solid #F0EAE1; height: 45px; font-weight: bold; color: #5C4033; cursor:pointer; font-size: 0.9rem;">
                        <option value="">Tüm Türler</option>
                        <option value=".pdf">Sadece PDF</option>
                        <option value=".docx">Sadece Word</option>
                        <option value=".xlsx">Sadece Excel</option>
                    </select>
                </div>

                <div class="col-lg-3 col-md-6">
                    <button class="btn font-weight-bold shadow-sm w-100" data-toggle="modal" data-target="#uploadModal" style="background-color: #C0392B; color: white; border-radius: 10px; height: 45px; font-size: 0.9rem;">
                        <i class="fas fa-cloud-upload-alt mr-1"></i> Yükle
                    </button>
                </div>
            </div>

            <div class="card premium-card">
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush" id="documentList" style="border-radius: 12px; overflow: hidden;">
                        @if (ViewBag.Documents != null)
                        {
                            var docs = (IEnumerable<DigitalLibrary.Models.Documents>)ViewBag.Documents;
                            int currentUserId = Session["UserID"] != null ? Convert.ToInt32(Session["UserID"]) : 0;

                            if (docs.Any())
                            {
                                foreach (var doc in docs)
                                {
                                    <li class="list-group-item p-0 doc-item-row" data-ext="@(doc.FileExtension != null ? doc.FileExtension.ToLower().Trim() : "")">
                                        <div class="d-flex justify-content-between align-items-center p-3">
                                            <div class="d-flex align-items-center">
                                                @if (doc.FileExtension == ".pdf")
                                                {<i class="fas fa-file-pdf text-danger fa-2x mr-3"></i> }
                                                else if (doc.FileExtension == ".docx" || doc.FileExtension == ".doc")
                                                { <i class="fas fa-file-word text-primary fa-2x mr-3"></i> }
                                                else if (doc.FileExtension == ".xlsx" || doc.FileExtension == ".xls")
                                                { <i class="fas fa-file-excel text-success fa-2x mr-3"></i> }
                                                else
                                                { <i class="fas fa-file text-muted-warm fa-2x mr-3"></i>}

                                                <div>
                                                    <div class="d-flex align-items-center">
                                                        <span class="font-weight-bold text-dark-wood" style="font-size: 1.05rem;">@doc.Title</span>

                                                        @if (doc.IsPrivate == true && doc.UserID == currentUserId)
                                                        {
                                                            <span class="badge-personal" title="Bu dosyayı sistemde sadece siz görebiliyorsunuz."><i class="fas fa-user-shield mr-1"></i> Bana Özel</span>
                                                        }
                                                    </div>
                                                    <small class="d-block mt-1 text-muted-warm font-weight-bold" style="font-size: 0.8rem;">
                                                        <i class="fas fa-calendar-alt mr-1"></i> @(doc.UploadDate.HasValue ? doc.UploadDate.Value.ToString("dd.MM.yyyy") : "-")
                                                        <span class="mx-2">|</span>
                                                        <span class="text-uppercase">@doc.FileExtension</span>
                                                    </small>
                                                </div>
                                            </div>

                                            <div class="d-flex align-items-center" style="gap: 8px;">
                                                <button class="btn btn-details-trigger shadow-sm" data-id="@doc.ID" title="Belge Bilgileri">
                                                    <i class="fas fa-eye"></i>
                                                </button>

                                                <a href="/Document/Download/@doc.ID" class="btn px-3 py-1 font-weight-bold btn-modern btn-modern-download shadow-sm">
                                                    <i class="fas fa-cloud-download-alt mr-1"></i> İndir
                                                </a>
                                            </div>
                                        </div>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="list-group-item py-5 text-center" style="background-color: #FCFAF7; border-radius: 10px; border: 2px dashed #EAE3D9; margin: 20px;">
                                    <div class="mb-3">
                                        <span class="fa-stack fa-2x" style="color: #EAE3D9;">
                                            <i class="fas fa-folder fa-stack-2x"></i>
                                            <i class="fas fa-folder-open fa-stack-2x" style="color: #FDFCFB;"></i>
                                            <i class="fas fa-search fa-stack-1x" style="color: #C0392B; margin-top: 10px;"></i>
                                        </span>
                                    </div>
                                    <h5 class="font-weight-bold" style="color: #5C4033;">Sistem Boş</h5>
                                    <p class="text-muted-warm mb-0" style="font-size: 0.9rem;">Sistemde şu an için hiç doküman bulunmuyor.</p>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <div class="modal-header" style="background-color: #FCF9F5; border-bottom: 1px solid #F0EAE1; border-radius: 15px 15px 0 0;">
                <h5 class="modal-title font-weight-bold" style="color: #2C1E16;"><i class="fas fa-cloud-upload-alt mr-2" style="color: #C0392B;"></i> Doküman Yükle</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <form action="/Document/Upload" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="Source" value="Personel" />
                <div class="modal-body p-4">
                    <div class="form-group">
                        <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Doküman Adı (Başlık)</label>
                        <input type="text" name="Title" class="form-control" required placeholder="Örn: 2026 İzin Formu" style="border-radius: 8px; border: 1px solid #F0EAE1;">
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Kısa Açıklama (İsteğe Bağlı)</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="Belge hakkında not..." style="border-radius: 8px; border: 1px solid #F0EAE1;"></textarea>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Hangi Klasöre Yüklenecek?</label>
                        <select name="CategoryID" class="form-control" required style="border-radius: 8px; border: 1px solid #F0EAE1;">
                            <option value="">-- Klasör Seçin --</option>
                            @if (Model != null)
                            {
                                foreach (var anaKat in Model.Where(k => k.ParentID == null))
                                {
                                    var altKlasorler = Model.Where(k => k.ParentID == anaKat.ID).ToList();

                                    if (altKlasorler.Any())
                                    {
                                        <optgroup label="@anaKat.Name">
                                            <option value="@anaKat.ID"> @anaKat.Name (Ana Klasör)</option>
                                            @foreach (var alt in altKlasorler)
                                            {
                                                <option value="@alt.ID">&nbsp;&nbsp;&nbsp; @alt.Name</option>
                                            }
                                        </optgroup>
                                    }
                                    else
                                    {
                                        <option value="@anaKat.ID"> @anaKat.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Görünürlük (Kimler Görebilir?)</label>
                        <select name="Visibility" class="form-control" style="border-radius: 8px; border: 1px solid #F0EAE1; background-color: #FDFCFB;">
                            <option value="Public"> Herkes (Tüm Personel Görebilir)</option>
                            <option value="Private"> Sadece Ben (Özel Doküman)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Dosya Seçin (PDF, DOCX, XLSX)</label>
                        <input type="file" name="uploadedFile" class="form-control-file" required accept=".pdf,.docx,.xlsx" style="padding: 10px; border: 1px dashed #C0392B; border-radius: 8px; background: #FDF3F2;">
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light font-weight-bold" data-dismiss="modal" style="border-radius: 8px;">İptal</button>
                    <button type="submit" class="btn font-weight-bold shadow-sm" style="background-color: #C0392B; color: white; border-radius: 8px;">Yükle</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="documentDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <div class="modal-header" style="background-color: #FCF9F5; border-bottom: 1px solid #F0EAE1; border-radius: 15px 15px 0 0;">
                <h5 class="modal-title font-weight-bold" style="color: #2C1E16;"><i class="fas fa-info-circle mr-2" style="color: #D48900;"></i> Belge Detayları</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body p-4 text-center">
                <div id="DetailDocIcon" class="mb-3"></div>
                <h4 class="font-weight-bold mb-3" id="DetailDocTitle" style="color: #2C1E16;">-</h4>

                <div class="text-left p-3 shadow-sm" style="border-radius: 10px; background-color: #FDFCFB; border: 1px solid #EAE3D9;">
                    <p class="mb-2"><i class="fas fa-folder-open mr-2" style="color: #D48900; width: 16px;"></i> <strong style="color: #5C4033;">Kategori:</strong> <span id="DetailDocCategory" class="text-muted float-right font-weight-bold">-</span></p>
                    <hr style="margin: 8px 0; border-color: #EAE3D9;">
                    <p class="mb-2"><i class="fas fa-user-edit mr-2" style="color: #7F736A; width: 16px;"></i> <strong style="color: #5C4033;">Yükleyen:</strong> <span id="DetailDocUploader" class="text-muted float-right">-</span></p>
                    <hr style="margin: 8px 0; border-color: #EAE3D9;">
                    <p class="mb-0"><i class="far fa-calendar-alt mr-2" style="color: #7F736A; width: 16px;"></i> <strong style="color: #5C4033;">Tarih:</strong> <span id="DetailDocDate" class="text-muted float-right">-</span></p>
                </div>

                <div class="mt-3 p-3 text-left shadow-sm" style="background-color: #FFFFFF; border: 1px solid #EAE3D9; border-radius: 10px;">
                    <p class="mb-1 font-weight-bold" style="color: #5C4033;"><i class="fas fa-align-left mr-1"></i> Açıklama Notu:</p>
                    <p class="mb-0 text-muted" id="DetailDocDesc" style="font-size: 0.9rem; line-height: 1.5;">-</p>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 justify-content-center mt-2">
                <a href="#" id="DetailDownloadBtn" class="btn font-weight-bold px-4 shadow-sm btn-modern-download" style="border-radius: 8px;"><i class="fas fa-download mr-2"></i> Belgeyi İndir</a>
                <button type="button" class="btn btn-light font-weight-bold px-4" data-dismiss="modal" style="border-radius: 8px; border: 1px solid #EAE3D9;">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {

            var currentUserId = parseInt('@(Session["UserID"] ?? "0")');

            function formatJsonDate(jsonDate) {
                if (!jsonDate) return "-";
                var dateString = jsonDate.substr(6);
                var currentTime = new Date(parseInt(dateString));
                var month = currentTime.getMonth() + 1;
                var day = currentTime.getDate();
                var year = currentTime.getFullYear();
                return (day < 10 ? '0' + day : day) + "." + (month < 10 ? '0' + month : month) + "." + year;
            }

            function dokumanlariEkranaBas(gelenVeri) {
                $("#documentList").empty();

                if (gelenVeri.length === 0) {
                    var bosKlasorHtml = `
                        <li class="list-group-item py-5 text-center" style="background-color: #FCFAF7; border-radius: 10px; border: 2px dashed #EAE3D9; margin: 20px;">
                            <div class="mb-3">
                                <span class="fa-stack fa-2x" style="color: #EAE3D9;">
                                  <i class="fas fa-folder fa-stack-2x"></i>
                                  <i class="fas fa-folder-open fa-stack-2x" style="color: #FDFCFB;"></i>
                                  <i class="fas fa-search fa-stack-1x" style="color: #C0392B; margin-top: 10px;"></i>
                                </span>
                            </div>
                            <h5 class="font-weight-bold" style="color: #5C4033;">Bu Klasör Boş</h5>
                            <p class="text-muted-warm mb-0" style="font-size: 0.9rem;">Seçtiğiniz kriterlere veya kategoriye ait sistemde henüz bir doküman bulunmuyor.</p>
                        </li>
                    `;
                    $("#documentList").append(bosKlasorHtml);
                    return;
                }

                $.each(gelenVeri, function (index, doc) {
                    var iconHtml = '<i class="fas fa-file text-muted-warm fa-2x mr-3"></i>';
                    var ext = doc.FileExtension ? $.trim(doc.FileExtension.toLowerCase()) : "";

                    if (ext === ".pdf") iconHtml = '<i class="fas fa-file-pdf text-danger fa-2x mr-3"></i>';
                    else if (ext === ".docx" || ext === ".doc") iconHtml = '<i class="fas fa-file-word text-primary fa-2x mr-3"></i>';
                    else if (ext === ".xlsx" || ext === ".xls") iconHtml = '<i class="fas fa-file-excel text-success fa-2x mr-3"></i>';

                    var tarihGosterimi = formatJsonDate(doc.UploadDate);
                    var badgeHtml = (doc.IsPrivate && doc.UserID === currentUserId) ? '<span class="badge-personal"><i class="fas fa-user-shield mr-1"></i> Bana Özel</span>' : '';

                    var listeElemani = $(`
                        <li class="list-group-item p-0 doc-item-row" data-ext="${ext}" style="display:none;">
                            <div class="d-flex justify-content-between align-items-center p-3">
                                <div class="d-flex align-items-center">
                                    ${iconHtml}
                                    <div>
                                        <div class="d-flex align-items-center">
                                            <span class="font-weight-bold text-dark-wood" style="font-size: 1.05rem;">${doc.Title}</span>
                                            ${badgeHtml}
                                        </div>
                                        <small class="d-block mt-1 text-muted-warm font-weight-bold" style="font-size: 0.8rem;">
                                            <i class="fas fa-calendar-alt mr-1"></i> ${tarihGosterimi} 
                                            <span class="mx-2">|</span> 
                                            <span class="text-uppercase">${ext}</span>
                                        </small>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center" style="gap: 8px;">
                                    <button class="btn btn-details-trigger shadow-sm" data-id="${doc.ID}" title="Belge Bilgileri">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <a href="/Document/Download/${doc.ID}" class="btn px-3 py-1 font-weight-bold btn-modern btn-modern-download shadow-sm">
                                        <i class="fas fa-cloud-download-alt mr-1"></i> İndir
                                    </a>
                                </div>
                            </div>
                        </li>
                    `);

                    $("#documentList").append(listeElemani);
                    listeElemani.fadeIn(200 + (index * 50));
                });

                uygulaDosyaTuruFiltresi();
            }

            function gosterYukleniyor() {
                $("#documentList").html('<li class="list-group-item py-5 text-center text-muted-warm"><i class="fas fa-circle-notch fa-spin fa-3x mb-3 d-block text-rust"></i>Belgeler getiriliyor...</li>');
            }

            function uygulaDosyaTuruFiltresi() {
                var secilenTur = $("#fileTypeFilter").val();

                if(!secilenTur) {
                    $(".doc-item-row").show();
                } else {
                    secilenTur = $.trim(secilenTur.toLowerCase());

                    $(".doc-item-row").each(function() {
                        var ext = $(this).attr("data-ext");
                        if (ext && $.trim(ext.toLowerCase()) === secilenTur) {
                            $(this).show();
                        } else {
                            $(this).hide();
                        }
                    });
                }
            }

            $("#fileTypeFilter").on("change", function() {
                uygulaDosyaTuruFiltresi();
            });

            var searchTimeout;
            $("#searchInput").on("keyup", function () {
                var arananKelime = $(this).val();

                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(function() {
                    gosterYukleniyor();
                    $.ajax({
                        url: '/Document/Search',
                        type: 'GET',
                        data: { kelime: arananKelime },
                        dataType: 'json',
                        success: function (gelenVeri) {
                            dokumanlariEkranaBas(gelenVeri);
                        }
                    });
                }, 400);
            });

            $(".tree-parent, .tree-child").on("click", function (e) {
                var klasorId = $(this).data("id");

                if(!klasorId) return;

                e.preventDefault();

                $(".tree-child, .tree-parent").removeClass("active");
                $(this).addClass("active");

                if ($(this).hasClass("tree-parent")) {
                    var altMenu = $("#kategoriMenu_" + klasorId);
                    var okIkonu = $(this).find(".ok-ikon");
                    var klasorIkonu = $(this).find(".folder-icon");

                    if (altMenu.length > 0) {
                        altMenu.slideToggle(200);
                        if (okIkonu.hasClass("fa-chevron-right")) {
                            okIkonu.removeClass("fa-chevron-right").addClass("fa-chevron-down");
                            klasorIkonu.removeClass("fa-folder").addClass("fa-folder-open");
                        } else {
                            okIkonu.removeClass("fa-chevron-down").addClass("fa-chevron-right");
                            klasorIkonu.removeClass("fa-folder-open").addClass("fa-folder");
                        }
                    }
                }

                gosterYukleniyor();
                $.ajax({
                    url: '/Document/GetByCategory',
                    type: 'GET',
                    data: { id: klasorId },
                    dataType: 'json',
                    success: function (gelenVeri) {
                        dokumanlariEkranaBas(gelenVeri);
                    }
                });
            });

            $(document).on('click', '.btn-details-trigger', function (e) {
                e.preventDefault();
                var docId = $(this).data("id");

                $.ajax({
                    url: '/Document/GetDocument/' + docId,
                    type: 'GET',
                    success: function (cevap) {
                        if(cevap.success) {
                            var data = cevap.data;
                            $("#DetailDocTitle").text(data.Title);
                            $("#DetailDocCategory").text(data.CategoryName ? data.CategoryName : "Kategorisiz");
                            $("#DetailDocUploader").text(data.UploaderName ? data.UploaderName : "Bilinmiyor");
                            $("#DetailDocDate").text(data.UploadDate ? data.UploadDate : "-");
                            $("#DetailDocDesc").text(data.Description ? data.Description : "Bu belge için açıklama notu girilmemiş.");
                            $("#DetailDownloadBtn").attr("href", "/Document/Download/" + data.ID);
                            $("#documentDetailsModal").modal('show');
                        } else {
                            Swal.fire('Erişim Reddedildi!', cevap.message, 'warning');
                        }
                    },
                    error: function() {
                        Swal.fire('Hata!', 'Sunucuya ulaşılamadı.', 'error');
                    }
                });
            });

            @if(TempData["Basari"] != null) {
                <text>Swal.fire('Başarılı!', '@TempData["Basari"]', 'success');</text>
            }
        });
    </script>
}