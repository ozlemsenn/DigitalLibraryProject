@using DigitalLibrary.Models
@model IEnumerable<Categories>

@{
    ViewBag.Title = "Ana Sayfa";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    .btn-modern {
        transition: all 0.3s ease;
        border-radius: 50px !important; 
    }

        .btn-modern:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1) !important;
        }
    .btn-modern-info:hover {
        background-color: #17a2b8;
        color: white !important;
    }
    .btn-modern-danger:hover {
        background-color: #dc3545;
        color: white !important;
    }
</style>

<div class="container mt-4">
    <div class="row">

        <div class="col-md-3">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Kategoriler</h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">

                        @foreach (var anaKategori in Model.Where(k => k.ParentID == null))
                        {
                            var altKategoriler = Model.Where(k => k.ParentID == anaKategori.ID).ToList();
                            var hedefId = "kategoriMenu_" + anaKategori.ID;

                            <a class="list-group-item list-group-item-action font-weight-bold kategori-sec d-flex justify-content-between align-items-center"
                               data-id="@anaKategori.ID"
                               style="cursor: pointer;">
                                <div>
                                    <i class="fas fa-folder text-warning mr-2"></i> @anaKategori.Name
                                </div>
                                @if (altKategoriler.Any())
                                {
                                    <i class="fas fa-chevron-down text-muted ok-ikonsu" style="font-size: 0.75rem;"></i>
                                }
                            </a>

                            if (altKategoriler.Any())
                            {//alt menüler
                                <div id="@hedefId" class="bg-light border-bottom" style="display: none;">
                                    @foreach (var altKategori in altKategoriler)
                                    {
                                        <a class="list-group-item list-group-item-action py-2 border-0 kategori-sec"
                                           data-id="@altKategori.ID"
                                           style="cursor: pointer; background: transparent; font-size: 0.95rem; padding-left: 2.5rem;">
                                            <i class="fas fa-level-up-alt fa-rotate-90 text-secondary mr-2"></i> @altKategori.Name
                                        </a>
                                    }
                                </div>
                            }
                        }

                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-9">

            <div class="input-group mb-3 shadow-sm">
                <input type="text" class="form-control border-right-0" id="searchInput" placeholder="Dokümanlarda ara...">
                <div class="input-group-append">
                    <button class="btn btn-primary" type="button">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>

            <div class="card mb-4 shadow-sm border-primary">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0"><i class="fas fa-upload mr-2"></i> Yeni Doküman Yükle</h6>
                </div>
                <div class="card-body">
                    <form action="/Document/Upload" method="post" enctype="multipart/form-data">
                        <div class="form-row">
                            <div class="col-md-4 mb-2">
                                <input type="text" name="Title" class="form-control" placeholder="Doküman Adı" required>
                            </div>
                            <div class="col-md-4 mb-2">
                                <select name="CategoryID" class="form-control" required>
                                    <option value="">Kategori Seçin...</option>
                                    @foreach (var kategori in Model)
                                    {
                                        <option value="@kategori.ID">@kategori.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3 mb-2">
                                <input type="file" name="uploadedFile" class="form-control-file mt-1" required>
                            </div>
                            <div class="col-md-1 mb-2">
                                <button type="submit" class="btn btn-success w-100"><i class="fas fa-check"></i></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Doküman Listesi</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush" id="documentList">

                        @if (ViewBag.Documents != null)
                        {
                            foreach (var doc in (IEnumerable<DigitalLibrary.Models.Documents>)ViewBag.Documents)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        @if (doc.FileExtension == ".pdf")
                                        {
                                            <i class="fas fa-file-pdf text-danger fa-2x align-middle mr-3"></i>
                                        }
                                        else if (doc.FileExtension == ".docx")
                                        {
                                            <i class="fas fa-file-word text-primary fa-2x align-middle mr-3"></i>
                                        }
                                        else if (doc.FileExtension == ".xlsx")
                                        {
                                            <i class="fas fa-file-excel text-success fa-2x align-middle mr-3"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-file text-secondary fa-2x align-middle mr-3"></i>
                                        }

                                        <span class="font-weight-bold" style="font-size: 1.1rem;">@doc.Title</span>
                                        <small class="text-muted d-block ml-5">
                                            @(doc.UploadDate.HasValue ? doc.UploadDate.Value.ToString("dd.MM.yyyy HH:mm") : "")
                                        </small>
                                    </div>

                                    <div class="d-flex align-items-center">
                                        <a href="/Document/Download/@doc.ID" class="btn btn-sm btn-light text-info border-info shadow-sm px-3 mr-2 font-weight-bold btn-modern btn-modern-info">
                                            <i class="fas fa-cloud-download-alt mr-1"></i> İndir
                                        </a>
                                        <button class="btn btn-sm btn-light text-danger border-danger shadow-sm px-3 btn-sil font-weight-bold btn-modern btn-modern-danger" data-id="@doc.ID">
                                            <i class="fas fa-trash-alt mr-1"></i> Sil
                                        </button>
                                    </div>
                                </li>
                            }
                        }

                    </ul>
                </div>
            </div>

        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {

            @if (TempData["Hata"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: '@Html.Raw(TempData["Hata"])',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'Tamam'
                });
                </text>
            }

            @if (TempData["Basari"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Başarılı!',
                    text: '@Html.Raw(TempData["Basari"])',
                    confirmButtonColor: '#28a745',
                    confirmButtonText: 'Harika'
                });
                </text>
            }

            $("#searchInput").on("keyup", function () {
                var arananKelime = $(this).val();

                $.ajax({
                    url: '/Document/Search',
                    type: 'GET',
                    data: { kelime: arananKelime },
                    dataType: 'json',
                    success: function (gelenVeri) {
                        $("#documentList").empty();

                        if (gelenVeri.length === 0) {
                            $("#documentList").append('<li class="list-group-item text-muted">Aranan kritere uygun doküman bulunamadı.</li>');
                            return;
                        }

                        $.each(gelenVeri, function (index, doc) {
                            var iconHtml = '<i class="fas fa-file text-secondary fa-2x align-middle mr-3"></i>';
                            if (doc.FileExtension === ".pdf") iconHtml = '<i class="fas fa-file-pdf text-danger fa-2x align-middle mr-3"></i>';
                            else if (doc.FileExtension === ".docx") iconHtml = '<i class="fas fa-file-word text-primary fa-2x align-middle mr-3"></i>';
                            else if (doc.FileExtension === ".xlsx") iconHtml = '<i class="fas fa-file-excel text-success fa-2x align-middle mr-3"></i>';

                            var listeElemani = `
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        ${iconHtml}
                                        <span class="font-weight-bold" style="font-size: 1.1rem;">${doc.Title}</span>
                                        <small class="text-muted d-block ml-5">${doc.UploadDateFormated}</small>
                                    </div>
                                    <!-- AJAX ARAMA SONUCU İNDİR VE SİL BUTONLARI -->
                                    <div class="btn-group">
                                        <a href="/Document/Download/${doc.ID}" class="btn btn-outline-info btn-sm">
                                            <i class="fas fa-download"></i> İndir
                                        </a>
                                        <button class="btn btn-outline-danger btn-sm btn-sil" data-id="${doc.ID}">
                                            <i class="fas fa-trash"></i> Sil
                                        </button>
                                    </div>
                                </li>
                            `;
                            $("#documentList").append(listeElemani);
                        });
                    },
                    error: function () {
                        console.log("AJAX isteğinde bir hata oluştu.");
                    }
                });
            });

            $(".kategori-sec").on("click", function () {
                var tiklananKategoriId = $(this).data("id");

                var altMenu = $("#kategoriMenu_" + tiklananKategoriId);
                if (altMenu.length > 0) {
                    altMenu.slideToggle(250);

                    var okIkonu = $(this).find(".ok-ikonsu");
                    if (okIkonu.hasClass("fa-chevron-down")) {
                        okIkonu.removeClass("fa-chevron-down").addClass("fa-chevron-up");
                    } else {
                        okIkonu.removeClass("fa-chevron-up").addClass("fa-chevron-down");
                    }
                }

                $(".kategori-sec").removeClass("list-group-item-secondary");
                $(this).addClass("list-group-item-secondary");

                $.ajax({
                    url: '/Document/GetByCategory',
                    type: 'GET',
                    data: { id: tiklananKategoriId },
                    dataType: 'json',
                    success: function (gelenVeri) {
                        $("#documentList").empty();

                        if (gelenVeri.length === 0) {
                            $("#documentList").append('<li class="list-group-item text-muted">Bu kategoride henüz doküman bulunmuyor.</li>');
                            return;
                        }

                        $.each(gelenVeri, function (index, doc) {
                            var iconHtml = '<i class="fas fa-file text-secondary fa-2x align-middle mr-3"></i>';
                            if (doc.FileExtension === ".pdf") iconHtml = '<i class="fas fa-file-pdf text-danger fa-2x align-middle mr-3"></i>';
                            else if (doc.FileExtension === ".docx") iconHtml = '<i class="fas fa-file-word text-primary fa-2x align-middle mr-3"></i>';
                            else if (doc.FileExtension === ".xlsx") iconHtml = '<i class="fas fa-file-excel text-success fa-2x align-middle mr-3"></i>';

                            var listeElemani = `
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        ${iconHtml}
                                        <span class="font-weight-bold" style="font-size: 1.1rem;">${doc.Title}</span>
                                        <small class="text-muted d-block ml-5">${doc.UploadDateFormated}</small>
                                    </div>
                                    <!-- AJAX KATEGORİ SONUCU İNDİR VE SİL BUTONLARI -->
                                    <div class="btn-group">
                                        <a href="/Document/Download/${doc.ID}" class="btn btn-outline-info btn-sm">
                                            <i class="fas fa-download"></i> İndir
                                        </a>
                                        <button class="btn btn-outline-danger btn-sm btn-sil" data-id="${doc.ID}">
                                            <i class="fas fa-trash"></i> Sil
                                        </button>
                                    </div>
                                </li>
                            `;
                            $("#documentList").append(listeElemani);
                        });
                    },
                    error: function () {
                        console.log("Kategori filtreleme sırasında hata oluştu.");
                    }
                });
            });

            $(document).on("click", ".btn-sil", function () {
                var silinecekId = $(this).data("id");
                var silinecekSatir = $(this).closest("li"); 

                Swal.fire({
                    title: 'Emin misiniz?',
                    text: "Bu doküman hem veritabanından hem de sunucudan kalıcı olarak silinecektir!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Evet, Sil!',
                    cancelButtonText: 'Vazgeç'
                }).then((result) => {
                    if (result.isConfirmed) {

                        $.ajax({
                            url: '/Document/Delete',
                            type: 'POST',
                            data: { id: silinecekId },
                            success: function (response) {
                                if (response.success) {
                                    silinecekSatir.slideUp(300, function() { $(this).remove(); });

                                    Swal.fire('Silindi!', response.message, 'success');
                                } else {
                                    Swal.fire('Hata!', response.message, 'error');
                                }
                            },
                            error: function () {
                                Swal.fire('Hata!', 'Sunucu ile iletişim kurulamadı.', 'error');
                            }
                        });
                    }
                });
            });

        });
    </script>
}