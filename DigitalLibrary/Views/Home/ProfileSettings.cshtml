@using DigitalLibrary.Models
@model Users

@{
    ViewBag.Title = "Profil Ayarları";

    if (Session["Role"] != null && Session["Role"].ToString() == "Admin")
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml"; 
    }
}

<div class="row mb-5">
    <div class="col-12">
        <h3 class="font-weight-bold mb-1" style="color: #2C1E16;"><i class="fas fa-user-cog mr-2" style="color: #D48900;"></i> Profil Ayarları</h3>
        <p style="color: #7F736A;">Hesap bilgilerinizi, iletişim tercihlerinizi ve şifrenizi buradan yönetebilirsiniz.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card premium-card text-center p-4 shadow-sm" style="border-radius: 12px; border: 1px solid #F0EAE1;">
            <div class="profile-img-ring mx-auto mb-3" style="width: 120px; height: 120px; border-radius: 50%; border: 4px solid #FDF3F2; padding: 5px;">
                <img src="https://ui-avatars.com/api/?name=@(Model != null ? Model.Name : "User")&background=D35400&color=fff&bold=true&size=120" alt="Profile Avatar" style="border-radius: 50%; width: 100%;">
            </div>

            <h4 class="font-weight-bold mb-1" style="color: #2C1E16;">@(Model != null ? Model.Name : "Bilinmeyen Kullanıcı")</h4>
            <p class="text-muted mb-2" style="font-size: 0.9rem;">@(Model != null ? Model.Role : "Rol Belirsiz")</p>

            <span class="badge mb-4" style="background-color: #FDF3F2; color: #C0392B; border: 1px solid #fae3db; padding: 6px 15px; font-weight: 600; font-size: 0.8rem; border-radius: 8px;">
                <i class="fas fa-building mr-1"></i> @(Model != null && !string.IsNullOrEmpty(Model.Department) ? Model.Department : "Departman Atanmamış")
            </span>

            <div class="text-left mt-2">
                <hr style="border-color: #F0EAE1;">
                <p class="mb-2" style="color: #7F736A; font-size: 0.9rem;"><i class="fas fa-envelope mr-2" style="color: #C0392B;"></i> @(Model != null ? Model.Email : "-")</p>
                <p class="mb-0" style="color: #7F736A; font-size: 0.9rem;"><i class="fas fa-shield-alt mr-2" style="color: #D48900;"></i> Güvenli Bağlantı (256-bit SSL)</p>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card premium-card shadow-sm" style="border-radius: 12px; border: 1px solid #F0EAE1;">
            <div class="card-header border-0 bg-transparent pt-4 pb-0 pl-4">
                <h5 class="font-weight-bold" style="color: #5C4033;">Hesap Bilgileri</h5>
            </div>
            <div class="card-body p-4">
                <form action="/Home/UpdateProfile" method="POST">
                    <input type="hidden" name="ID" value="@(Model != null ? Model.ID : 0)" />

                    <div class="row">
                        <div class="col-md-6 form-group mb-4">
                            <label class="font-weight-bold" style="color: #7F736A;">Ad Soyad</label>
                            <input type="text" name="Name" class="form-control" value="@(Model != null ? Model.Name : "")" required style="border-radius: 8px; border: 1px solid #F0EAE1; padding: 10px 15px;">
                        </div>
                        <div class="col-md-6 form-group mb-4">
                            <label class="font-weight-bold" style="color: #7F736A;">E-Posta Adresi</label>
                            <input type="email" name="Email" class="form-control" value="@(Model != null ? Model.Email : "")" required style="border-radius: 8px; border: 1px solid #F0EAE1; padding: 10px 15px;">
                        </div>

                        <div class="col-md-12 form-group mb-4">
                            @if (Session["Role"] != null && Session["Role"].ToString() == "Admin")
                            {
                                <label class="font-weight-bold" style="color: #7F736A;">Departmanınız</label>
                                <input type="text" name="Department" class="form-control" value="@(Model != null ? Model.Department : "")" style="border-radius: 8px; border: 1px solid #F0EAE1; padding: 10px 15px;">
                            }
                            else
                            {
                                <label class="font-weight-bold" style="color: #7F736A;">Departmanınız <small class="text-muted">(Değişiklik için yöneticiye başvurun)</small></label>
                                <input type="text" class="form-control" value="@(Model != null ? Model.Department : "")" readonly style="border-radius: 8px; border: 1px solid #F0EAE1; padding: 10px 15px; background-color: #FCF9F5; cursor: not-allowed;">
                            }
                        </div>
                    </div>

                    <hr style="border-color: #F0EAE1; margin: 20px 0 30px 0;">
                    <h5 class="font-weight-bold mb-4" style="color: #5C4033;"><i class="fas fa-lock mr-2 text-muted"></i> Şifre Değiştirme (İsteğe Bağlı)</h5>

                    <div class="row">
                        <div class="col-md-6 form-group mb-4">
                            <label class="font-weight-bold" style="color: #7F736A;">Mevcut Şifreniz</label>
                            <input type="password" name="OldPassword" class="form-control" placeholder="Değiştirmeyecekseniz boş bırakın" style="border-radius: 8px; border: 1px solid #F0EAE1; padding: 10px 15px;">
                        </div>
                        <div class="col-md-6 form-group mb-4">
                            <label class="font-weight-bold" style="color: #7F736A;">Yeni Şifreniz</label>
                            <input type="password" name="NewPassword" class="form-control" placeholder="Yeni şifrenizi girin" style="border-radius: 8px; border: 1px solid #F0EAE1; padding: 10px 15px;">
                        </div>
                    </div>

                    <div class="text-right mt-3">
                        <button type="submit" class="btn font-weight-bold shadow-sm px-5 py-2" style="background-color: #C0392B; color: white; border-radius: 8px; transition: 0.2s;">
                            <i class="fas fa-save mr-2"></i> Değişiklikleri Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            @if(TempData["Basari"] != null) {
                <text>Swal.fire('Harika!', '@TempData["Basari"]', 'success');</text>
            }
            @if(TempData["Hata"] != null) {
                <text>Swal.fire('Hata!', '@TempData["Hata"]', 'error');</text>
            }
        });
    </script>
}