@using DigitalLibrary.Models
@model Users

@{
    ViewBag.Title = "Profil Ayarları";

    if (Session["Role"] != null && Session["Role"].ToString() == "Admin")
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    :root {
        --wood-dark: #2C1E16;
        --wood-medium: #5C4033;
        --rust: #C0392B;
        --bg-ivory: #FCF9F5;
        --gold: #D48900;
    }

    body {
        background-color: var(--bg-ivory) !important;
    }

    .premium-card {
        border-radius: 12px;
        border: 1px solid rgba(0,0,0,0.04);
        background-color: #FFFFFF;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03) !important;
    }

    .premium-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .premium-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(92, 64, 51, 0.12) !important;
        }

    .form-control:focus {
        border-color: #D48900 !important;
        box-shadow: 0 0 0 0.2rem rgba(212, 137, 0, 0.15) !important;
    }

    .password-toggle {
        cursor: pointer;
        background-color: transparent;
        border-left: none;
        color: #7F736A;
        transition: 0.2s;
    }

        .password-toggle:hover {
            color: #C0392B;
        }

    .input-group-password .form-control {
        border-right: none;
    }

        .input-group-password .form-control:focus + .input-group-append .password-toggle {
            border-color: #D48900 !important;
        }
</style>

<div class="container-fluid px-md-5 mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h3 class="font-weight-bold mb-1" style="color: #2C1E16;"><i class="fas fa-user-cog mr-2" style="color: #D48900;"></i> Profil Ayarları</h3>
            <p style="color: #7F736A;">Hesap bilgilerinizi, iletişim tercihlerinizi ve şifrenizi buradan yönetebilirsiniz.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4 col-md-5 mb-4">
            <div class="card premium-card premium-hover text-center p-4">
                <div class="profile-img-ring mx-auto mb-3" style="width: 130px; height: 130px; border-radius: 50%; border: 4px solid #FDF3F2; padding: 5px;">
                    <img src="https://ui-avatars.com/api/?name=@(Model != null ? Model.Name : "User")&background=D35400&color=fff&bold=true&size=130" alt="Profile Avatar" style="border-radius: 50%; width: 100%; box-shadow: 0 4px 10px rgba(211, 84, 0, 0.2);">
                </div>

                <h4 class="font-weight-bold mb-1" style="color: #2C1E16;">@(Model != null ? Model.Name : "Bilinmeyen Kullanıcı")</h4>
                <p class="text-muted mb-3" style="font-size: 0.95rem; font-weight: 500;">@(Model != null ? Model.Role : "Rol Belirsiz")</p>

                <span class="badge mb-3" style="background-color: #FDF3F2; color: #C0392B; border: 1px solid #fae3db; padding: 8px 15px; font-weight: 600; font-size: 0.85rem; border-radius: 8px;">
                    <i class="fas fa-building mr-1"></i> @(Model != null && !string.IsNullOrEmpty(Model.Department) ? Model.Department : "Departman Atanmamış")
                </span>

                <div class="text-left mt-3">
                    <hr style="border-color: #F0EAE1; margin-bottom: 15px;">
                    <p class="mb-2 font-weight-bold" style="color: #5C4033; font-size: 0.9rem;"><i class="fas fa-envelope mr-2" style="color: #D48900;"></i> @(Model != null ? Model.Email : "-")</p>
                    <p class="mb-0 font-weight-bold" style="color: #27ae60; font-size: 0.9rem;"><i class="fas fa-shield-alt mr-2"></i> Güvenli Bağlantı (256-bit SSL)</p>
                </div>
            </div>
        </div>

        <div class="col-lg-8 col-md-7">
            <div class="card premium-card h-100">
                <div class="card-header border-0 bg-transparent pt-4 pb-0 px-4">
                    <h5 class="font-weight-bold" style="color: #5C4033;"><i class="fas fa-id-card mr-2 text-muted"></i> Kişisel Bilgiler</h5>
                </div>
                <div class="card-body p-4">
                    <form action="/Home/UpdateProfile" method="POST" id="profileForm">
                        <input type="hidden" name="ID" value="@(Model != null ? Model.ID : 0)" />

                        <div class="row">
                            <div class="col-md-6 form-group mb-4">
                                <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Ad Soyad</label>
                                <input type="text" name="Name" class="form-control" value="@(Model != null ? Model.Name : "")" required style="border-radius: 8px; border: 1px solid #F0EAE1; padding: 10px 15px; font-weight: 600; color: #2C1E16;">
                            </div>
                            <div class="col-md-6 form-group mb-4">
                                <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">E-Posta Adresi</label>
                                <input type="email" name="Email" class="form-control" value="@(Model != null ? Model.Email : "")" required style="border-radius: 8px; border: 1px solid #F0EAE1; padding: 10px 15px; font-weight: 600; color: #2C1E16;">
                            </div>

                            <div class="col-md-12 form-group mb-4">
                                @if (Session["Role"] != null && Session["Role"].ToString() == "Admin")
                                {
                                    <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Departmanınız</label>
                                    <input type="text" name="Department" class="form-control" value="@(Model != null ? Model.Department : "")" style="border-radius: 8px; border: 1px solid #F0EAE1; padding: 10px 15px; font-weight: 600; color: #2C1E16;">
                                }
                                else
                                {
                                    <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Departmanınız <small class="text-muted ml-1" style="font-weight: normal;">(Değişiklik için yöneticiye başvurun)</small></label>
                                    <input type="text" class="form-control" value="@(Model != null ? Model.Department : "")" readonly style="border-radius: 8px; border: 1px solid #EAE3D9; padding: 10px 15px; background-color: #FCFAF7; color: #7F736A; cursor: not-allowed;">
                                }
                            </div>
                        </div>

                        <hr style="border-color: #F0EAE1; margin: 15px 0 25px 0;">

                        <h5 class="font-weight-bold mb-4" style="color: #5C4033;"><i class="fas fa-lock mr-2 text-muted"></i> Şifre Değiştirme <small style="font-size: 0.85rem; color: #7F736A; font-weight: normal;">(İsteğe Bağlı)</small></h5>

                        <div class="row">
                            <div class="col-md-12 form-group mb-3">
                                <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Mevcut Şifreniz</label>
                                <div class="input-group input-group-password">
                                    <input type="password" name="OldPassword" class="form-control" placeholder="Değiştirmeyecekseniz boş bırakın" style="border-radius: 8px 0 0 8px; border: 1px solid #F0EAE1; padding: 10px 15px;">
                                    <div class="input-group-append">
                                        <span class="input-group-text password-toggle" style="border-radius: 0 8px 8px 0; border: 1px solid #F0EAE1;">
                                            <i class="far fa-eye"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6 form-group mb-4">
                                <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Yeni Şifreniz</label>
                                <div class="input-group input-group-password">
                                    <input type="password" name="NewPassword" id="NewPassword" class="form-control" placeholder="Yeni şifrenizi girin" style="border-radius: 8px 0 0 8px; border: 1px solid #F0EAE1; padding: 10px 15px;">
                                    <div class="input-group-append">
                                        <span class="input-group-text password-toggle" style="border-radius: 0 8px 8px 0; border: 1px solid #F0EAE1;">
                                            <i class="far fa-eye"></i>
                                        </span>
                                    </div>
                                </div>
                                <small class="form-text text-muted mt-1" style="font-size: 0.75rem;"><i class="fas fa-info-circle mr-1"></i>En az 8 karakter, 1 harf ve 1 rakam içermelidir.</small>
                            </div>

                            <div class="col-md-6 form-group mb-4">
                                <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Yeni Şifreniz (Tekrar)</label>
                                <div class="input-group input-group-password">
                                    <input type="password" id="ConfirmPassword" class="form-control" placeholder="Şifrenizi tekrar girin" style="border-radius: 8px 0 0 8px; border: 1px solid #F0EAE1; padding: 10px 15px;">
                                    <div class="input-group-append">
                                        <span class="input-group-text password-toggle" style="border-radius: 0 8px 8px 0; border: 1px solid #F0EAE1;">
                                            <i class="far fa-eye"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="text-right mt-2">
                            <button type="submit" class="btn font-weight-bold shadow-sm px-5 py-2" style="background-color: #C0392B; color: white; border-radius: 8px; transition: 0.2s;">
                                <i class="fas fa-save mr-2"></i> Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {

            $('.password-toggle').on('click', function() {
                var input = $(this).closest('.input-group').find('input');
                var icon = $(this).find('i');

                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                    $(this).css('color', '#C0392B');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                    $(this).css('color', '#7F736A');
                }
            });

            $('#profileForm').on('submit', function (e) {
                var oldPass = $('input[name="OldPassword"]').val();
                var newPass = $('#NewPassword').val();
                var confirmPass = $('#ConfirmPassword').val();

                if (newPass !== "") {
                    if (newPass !== confirmPass) {
                        e.preventDefault();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Şifreler Eşleşmiyor!',
                            text: 'Lütfen girdiğiniz yeni şifrelerin birbiriyle aynı olduğundan emin olun.',
                            confirmButtonColor: '#C0392B'
                        });
                        return;
                    }

                    if (oldPass !== "" && oldPass === newPass) {
                        e.preventDefault();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Hatalı Seçim!',
                            text: 'Yeni şifreniz eski şifrenizle aynı olamaz. Lütfen farklı bir şifre belirleyin.',
                            confirmButtonColor: '#C0392B'
                        });
                        return;
                    }

                    var passRegex = /^(?=.*[a-zA-ZğüşıöçĞÜŞİÖÇ])(?=.*\d).{8,}$/;
                    if (!passRegex.test(newPass)) {
                        e.preventDefault();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Zayıf Şifre!',
                            text: 'Şifreniz kurallara uymuyor. En az 8 karakter uzunluğunda olmalı, en az bir harf ve bir rakam içermelidir.',
                            confirmButtonColor: '#C0392B'
                        });
                        return;
                    }
                }
            });

           @if(TempData["Basari"] != null) {
                <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Harika!',
                        html: '@Html.Raw(TempData["Basari"])',
                        confirmButtonColor: '#27ae60'
                    });
                </text>
            }

            @if(TempData["Hata"] != null) {
                <text>
                    Swal.fire({
                        icon: 'error',
                        title: 'Hata!',
                        html: '@Html.Raw(TempData["Hata"])',
                        confirmButtonColor: '#C0392B'
                    });
                </text>
            }
        });
    </script>
}