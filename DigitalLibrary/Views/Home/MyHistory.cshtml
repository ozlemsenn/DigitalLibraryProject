@using DigitalLibrary.Models
@model IEnumerable<Logs>

@{
    ViewBag.Title = "İşlem Geçmişim";
}

<style>
    .timeline {
        position: relative;
        padding-left: 30px;
        border-left: 2px solid #EAE3D9;
        margin-left: 20px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 25px;
    }

    .timeline-icon {
        position: absolute;
        left: -47px;
        top: 0;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: #FFFFFF;
        border: 2px solid #C0392B;
        color: #C0392B;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
    }
</style>

<div class="row mb-5">
    <div class="col-12">
        <h3 class="font-weight-bold mb-1" style="color: #2C1E16;"><i class="fas fa-history mr-2" style="color: #5C4033;"></i> İşlem Geçmişim</h3>
        <p style="color: #7F736A;">Sistem üzerinde gerçekleştirdiğiniz son aktivitelerin dökümü.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-10">
        <div class="card premium-card p-4">
            <div class="timeline">
                @if (Model != null && Model.Any())
                {
                    foreach (var log in Model)
                    {
                        <div class="timeline-item">
                            <div class="timeline-icon">
                                <i class="fas @(log.IconClass ?? "fa-bolt")"></i>
                            </div>
                            <div class="pb-2">
                                <h6 class="font-weight-bold mb-1" style="color: #2C1E16;">@log.ActionType</h6>
                                <p class="mb-1" style="color: #5C4033; font-size: 0.95rem;">@log.Description</p>
                                <small class="font-weight-bold" style="color: #7F736A;"><i class="far fa-clock mr-1"></i> @(log.CreatedAt.HasValue ? log.CreatedAt.Value.ToString("dd MMMM yyyy - HH:mm") : "")</small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fas fa-ghost fa-2x mb-2 d-block" style="color: #EAE3D9;"></i> Henüz bir işlem geçmişiniz bulunmuyor.
                    </div>
                }
            </div>
        </div>
    </div>
</div>