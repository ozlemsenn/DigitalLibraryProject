@using DigitalLibrary.Models
@model IEnumerable<Documents>

@{
    ViewBag.Title = "Kişisel Arşivim (Yüklediğim Belgeler)";
    var kategoriler = ViewBag.Categories as IEnumerable<Categories>;
    var userLogs = ViewBag.UserLogs as IEnumerable<Logs>;

    int totalDocs = Model != null ? Model.Count() : 0;
    int privateDocs = Model != null ? Model.Count(d => d.IsPrivate == true) : 0;
    int publicDocs = totalDocs - privateDocs;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    :root {
        --wood-dark: #2C1E16;
        --wood-medium: #5C4033;
        --rust: #C0392B;
        --bg-ivory: #FCF9F5;
        --gold: #D48900;
    }

    body {
        background-color: var(--bg-ivory) !important;
    }

    .premium-card {
        border-radius: 12px;
        border: 1px solid rgba(0,0,0,0.04);
        background-color: #FFFFFF;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03) !important;
    }

    .premium-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .premium-hover:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(92, 64, 51, 0.12) !important;
        }

    .mini-stat-card {
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        border: 1px solid #EAE3D9;
    }

    .doc-item-row {
        transition: 0.2s;
    }

        .doc-item-row:hover {
            background-color: #FCFAF7;
        }

    .badge-personal {
        background-color: #e8f0fe;
        color: #2980b9;
        border: 1px solid #d6eaf8;
        padding: 4px 10px;
        font-size: 0.75rem;
        border-radius: 6px;
        font-weight: 600;
        margin-left: 10px;
    }

    .badge-public {
        background-color: #e8f8f5;
        color: #27ae60;
        border: 1px solid #c8e6c9;
        padding: 4px 10px;
        font-size: 0.75rem;
        border-radius: 6px;
        font-weight: 600;
        margin-left: 10px;
    }

    .btn-action {
        width: 35px;
        height: 35px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: 0.2s;
        font-size: 0.95rem;
        border: 1px solid #EAE3D9;
        background-color: #FFF;
    }

    .btn-action-download {
        color: #27ae60;
    }

        .btn-action-download:hover {
            background-color: #27ae60;
            color: white;
            border-color: #27ae60;
        }

    .btn-action-edit {
        color: #D48900;
    }

        .btn-action-edit:hover {
            background-color: #D48900;
            color: white;
            border-color: #D48900;
        }

    .btn-action-delete {
        color: #C0392B;
    }

        .btn-action-delete:hover {
            background-color: #C0392B;
            color: white;
            border-color: #C0392B;
        }

    .btn-action-view {
        color: #7F736A;
    }

        .btn-action-view:hover {
            background-color: #5C4033;
            color: white;
            border-color: #5C4033;
        }

    .filter-pill {
        border-radius: 20px;
        padding: 6px 16px;
        font-weight: 600;
        font-size: 0.85rem;
        color: #7F736A;
        border: 1px solid #EAE3D9;
        background: #FFF;
        cursor: pointer;
        transition: 0.2s;
    }

        .filter-pill:hover, .filter-pill.active {
            background-color: #5C4033;
            color: white;
            border-color: #5C4033;
        }

    .timeline {
        position: relative;
        padding-left: 25px;
        border-left: 2px solid #EAE3D9;
        margin-left: 15px;
        margin-top: 10px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 25px;
    }

    .timeline-icon {
        position: absolute;
        left: -42px;
        top: 0;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: #FFFFFF;
        border: 2px solid #C0392B;
        color: #C0392B;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
    }
</style>

<div class="container-fluid px-md-5 mt-4">

    <div class="row mb-4 align-items-center">
        <div class="col-lg-6">
            <h3 class="font-weight-bold mb-1" style="color: #2C1E16;"><i class="fas fa-folder-open mr-2 text-rust"></i> Kişisel Arşivim</h3>
            <p style="color: #7F736A; font-size: 0.95rem;">Sisteme yüklediğiniz belgeleri görüntüleyin, yetkilerini düzenleyin veya silin.</p>
        </div>
        <div class="col-lg-6 text-lg-right mt-3 mt-lg-0">
            <button class="btn font-weight-bold shadow-sm px-4 py-2 mr-2 mb-2 mb-sm-0" data-toggle="modal" data-target="#historyModal" style="background-color: #FFFFFF; color: #5C4033; border: 1px solid #EAE3D9; border-radius: 10px;">
                <i class="fas fa-history mr-2" style="color: #D48900;"></i> Son İşlemlerim
            </button>
            <button class="btn font-weight-bold shadow-sm px-4 py-2 mb-2 mb-sm-0" data-toggle="modal" data-target="#uploadModal" style="background-color: #C0392B; color: white; border-radius: 10px;">
                <i class="fas fa-cloud-upload-alt mr-2"></i> Yeni Belge Yükle
            </button>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4 mb-3 mb-md-0">
            <div class="premium-card mini-stat-card premium-hover">
                <div style="background-color: #FDF3F2; padding: 15px; border-radius: 12px; color: #C0392B;">
                    <i class="fas fa-file-alt fa-2x"></i>
                </div>
                <div>
                    <h6 class="text-uppercase mb-0" style="color: #7F736A; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.5px;">Toplam Dosya</h6>
                    <h3 class="font-weight-bold mb-0 text-dark-wood">@totalDocs</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3 mb-md-0">
            <div class="premium-card mini-stat-card premium-hover">
                <div style="background-color: #e8f0fe; padding: 15px; border-radius: 12px; color: #2980b9;">
                    <i class="fas fa-user-shield fa-2x"></i>
                </div>
                <div>
                    <h6 class="text-uppercase mb-0" style="color: #7F736A; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.5px;">Sadece Bana Özel</h6>
                    <h3 class="font-weight-bold mb-0 text-dark-wood">@privateDocs</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="premium-card mini-stat-card premium-hover">
                <div style="background-color: #e8f8f5; padding: 15px; border-radius: 12px; color: #27ae60;">
                    <i class="fas fa-globe fa-2x"></i>
                </div>
                <div>
                    <h6 class="text-uppercase mb-0" style="color: #7F736A; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.5px;">Herkese Açık</h6>
                    <h3 class="font-weight-bold mb-0 text-dark-wood">@publicDocs</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="premium-card p-3 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex gap-2" id="privacyFilters">
                    <button class="filter-pill active" data-filter="all">Tümü</button>
                    <button class="filter-pill" data-filter="private"><i class="fas fa-lock mr-1"></i> Özel Dosyalarım</button>
                    <button class="filter-pill" data-filter="public"><i class="fas fa-globe mr-1"></i> Genel Dosyalar</button>
                </div>

                <div class="input-group" style="max-width: 350px; border-radius: 20px; overflow: hidden; border: 1px solid #EAE3D9;">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-transparent border-0 text-rust pl-3"><i class="fas fa-search"></i></span>
                    </div>
                    <input type="text" class="form-control border-0 font-weight-bold text-dark-wood" id="myDocSearch" placeholder="Dosyalarım içinde ara..." style="box-shadow: none; font-size: 0.95rem;">
                </div>
            </div>

            <div class="card premium-card">
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush" id="myDocumentsList" style="border-radius: 12px; overflow: hidden;">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var doc in Model)
                            {
                                string privacyClass = doc.IsPrivate == true ? "private" : "public";

                                <li class="list-group-item p-0 doc-item-row" data-privacy="@privacyClass">
                                    <div class="d-flex justify-content-between align-items-center p-3">
                                        <div class="d-flex align-items-center" style="max-width: 70%;">
                                            @if (doc.FileExtension == ".pdf")
                                            {<i class="fas fa-file-pdf text-danger fa-3x mr-3"></i> }
                                            else if (doc.FileExtension == ".docx" || doc.FileExtension == ".doc")
                                            { <i class="fas fa-file-word text-primary fa-3x mr-3"></i> }
                                            else if (doc.FileExtension == ".xlsx" || doc.FileExtension == ".xls")
                                            { <i class="fas fa-file-excel text-success fa-3x mr-3"></i> }
                                            else
                                            { <i class="fas fa-file text-muted-warm fa-3x mr-3"></i>}

                                            <div class="text-truncate">
                                                <div class="d-flex align-items-center mb-1">
                                                    <span class="font-weight-bold text-dark-wood doc-title-text" style="font-size: 1.1rem;" title="@doc.Title">@doc.Title</span>
                                                    @if (doc.IsPrivate == true)
                                                    {
                                                        <span class="badge-personal"><i class="fas fa-lock mr-1"></i> Sadece Ben</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge-public"><i class="fas fa-globe mr-1"></i> Herkes</span>
                                                    }
                                                </div>
                                                <small class="text-muted-warm font-weight-bold" style="font-size: 0.85rem;">
                                                    <i class="fas fa-calendar-alt mr-1"></i> @(doc.UploadDate.HasValue ? doc.UploadDate.Value.ToString("dd.MM.yyyy HH:mm") : "-")
                                                    <span class="mx-2">|</span>
                                                    <span class="text-uppercase">@doc.FileExtension</span>
                                                </small>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center" style="gap: 8px;">
                                            <button class="btn btn-action btn-action-view btn-details-trigger shadow-sm" data-id="@doc.ID" title="Detayları İncele"><i class="fas fa-eye"></i></button>
                                            <a href="/Document/Download/@doc.ID" class="btn btn-action btn-action-download shadow-sm" title="İndir"><i class="fas fa-download"></i></a>
                                            <button class="btn btn-action btn-action-edit btn-edit-trigger shadow-sm" data-id="@doc.ID" title="Belgeyi Düzenle"><i class="fas fa-pen"></i></button>
                                            <button class="btn btn-action btn-action-delete btn-delete-trigger shadow-sm" data-id="@doc.ID" title="Kalıcı Olarak Sil"><i class="fas fa-trash"></i></button>
                                        </div>
                                    </div>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item py-5 text-center text-muted-warm" id="emptyStateMsg">
                                <i class="fas fa-box-open fa-4x mb-3 d-block" style="color: #EAE3D9;"></i>
                                <h5 class="font-weight-bold text-dark-wood">Arşiviniz Boş</h5>
                                <p>Henüz sisteme bir doküman yüklemediniz.</p>
                            </li>
                        }

                        <li class="list-group-item py-5 text-center text-muted-warm" id="noResultMsg" style="display: none;">
                            <i class="fas fa-search fa-3x mb-3 d-block text-rust opacity-50"></i>
                            Arama kriterlerinize uygun belge bulunamadı.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="historyModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <div class="modal-header" style="background-color: #FCF9F5; border-bottom: 1px solid #F0EAE1; border-radius: 15px 15px 0 0;">
                <h5 class="modal-title font-weight-bold" style="color: #2C1E16;"><i class="fas fa-history mr-2" style="color: #D48900;"></i> Son İşlemlerim</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body p-4">
                <div class="timeline">
                    @if (userLogs != null && userLogs.Any())
                    {
                        foreach (var log in userLogs)
                        {
                            <div class="timeline-item">
                                <div class="timeline-icon shadow-sm">
                                    <i class="fas @(log.IconClass ?? "fa-bolt")"></i>
                                </div>
                                <div class="pb-2">
                                    <h6 class="font-weight-bold mb-1" style="color: #2C1E16;">@log.ActionType</h6>
                                    <p class="mb-1 text-muted" style="font-size: 0.9rem; line-height: 1.4;">@log.Description</p>
                                    <small class="font-weight-bold" style="color: #D48900;"><i class="far fa-clock mr-1"></i> @(log.CreatedAt.HasValue ? log.CreatedAt.Value.ToString("dd MMM HH:mm") : "")</small>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fas fa-ghost fa-2x mb-2 d-block" style="color: #EAE3D9;"></i> Henüz sistemde bir işleminiz bulunmuyor.
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light font-weight-bold w-100" data-dismiss="modal" style="border-radius: 8px;">Kapat</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <div class="modal-header" style="background-color: #FCF9F5; border-bottom: 1px solid #F0EAE1;">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-pen mr-2" style="color: #D48900;"></i> Belgeyi Düzenle</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body p-4">
                <form id="editForm">
                    <input type="hidden" id="EditDocID" />
                    <div class="form-group">
                        <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Başlık</label>
                        <input type="text" id="EditTitle" class="form-control" style="border-radius: 8px; border: 1px solid #F0EAE1;">
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Kısa Açıklama (Not)</label>
                        <textarea id="EditDescription" class="form-control" rows="2" style="border-radius: 8px; border: 1px solid #F0EAE1;"></textarea>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Klasör Konumu</label>
                        <select id="EditCategoryID" class="form-control" style="border-radius: 8px; border: 1px solid #F0EAE1;">
                            @if (kategoriler != null)
                            {
                                foreach (var kat in kategoriler.Where(k => k.ParentID != null))
                                {
                                    <option value="@kat.ID">@kat.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Görünürlük (Yetki)</label>
                        <select id="EditVisibility" class="form-control" style="border-radius: 8px; border: 1px solid #F0EAE1;">
                            <option value="false">👁️ Herkes (Tüm Personel Görebilir)</option>
                            <option value="true">🔒 Sadece Ben (Özel Doküman)</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light font-weight-bold" data-dismiss="modal" style="border-radius: 8px;">İptal</button>
                <button type="button" id="btnUpdate" class="btn text-white font-weight-bold px-4" style="background-color: #D48900; border-radius: 8px;">Değişiklikleri Kaydet</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <div class="modal-header" style="background-color: #FCF9F5; border-bottom: 1px solid #F0EAE1; border-radius: 15px 15px 0 0;">
                <h5 class="modal-title font-weight-bold" style="color: #2C1E16;"><i class="fas fa-cloud-upload-alt mr-2" style="color: #C0392B;"></i> Yeni Belge Yükle</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <form action="/Document/Upload" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="Source" value="MyDocuments" />
                <div class="modal-body p-4">
                    <div class="form-group">
                        <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Doküman Adı (Başlık)</label>
                        <input type="text" name="Title" class="form-control" required placeholder="Örn: 2026 İzin Formu" style="border-radius: 8px; border: 1px solid #F0EAE1;">
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Kısa Açıklama (İsteğe Bağlı)</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="Belge hakkında not..." style="border-radius: 8px; border: 1px solid #F0EAE1;"></textarea>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Hangi Klasöre Yüklenecek?</label>
                        <select name="CategoryID" class="form-control" required style="border-radius: 8px; border: 1px solid #F0EAE1;">
                            <option value="">-- Klasör Seçin --</option>
                            @if (kategoriler != null)
                            {
                                foreach (var anaKat in kategoriler.Where(k => k.ParentID == null))
                                {
                                    var altKlasorler = kategoriler.Where(k => k.ParentID == anaKat.ID).ToList();

                                    if (altKlasorler.Any())
                                    {
                                        <optgroup label="@anaKat.Name">
                                            <option value="@anaKat.ID"> @anaKat.Name (Ana Klasör)</option>
                                            @foreach (var alt in altKlasorler)
                                            {
                                                <option value="@alt.ID">&nbsp;&nbsp;&nbsp; @alt.Name</option>
                                            }
                                        </optgroup>
                                    }
                                    else
                                    {
                                        <option value="@anaKat.ID"> @anaKat.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Görünürlük (Kimler Görebilir?)</label>
                        <select name="Visibility" class="form-control" style="border-radius: 8px; border: 1px solid #F0EAE1; background-color: #FDFCFB;">
                            <option value="Public"> Herkes (Tüm Personel Görebilir)</option>
                            <option value="Private"> Sadece Ben (Özel Doküman)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold" style="color: #7F736A; font-size: 0.9rem;">Dosya Seçin (PDF, DOCX, XLSX)</label>
                        <input type="file" name="uploadedFile" class="form-control-file" required accept=".pdf,.docx,.xlsx" style="padding: 10px; border: 1px dashed #C0392B; border-radius: 8px; background: #FDF3F2;">
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light font-weight-bold" data-dismiss="modal" style="border-radius: 8px;">İptal</button>
                    <button type="submit" class="btn font-weight-bold shadow-sm" style="background-color: #C0392B; color: white; border-radius: 8px;">Yükle</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="documentDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <div class="modal-header" style="background-color: #FCF9F5; border-bottom: 1px solid #F0EAE1; border-radius: 15px 15px 0 0;">
                <h5 class="modal-title font-weight-bold" style="color: #2C1E16;"><i class="fas fa-info-circle mr-2" style="color: #D48900;"></i> Belge Detayları</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body p-4 text-center">
                <div id="DetailDocIcon" class="mb-3"></div>
                <h4 class="font-weight-bold mb-3" id="DetailDocTitle" style="color: #2C1E16;">-</h4>

                <div class="text-left p-3 shadow-sm" style="border-radius: 10px; background-color: #FDFCFB; border: 1px solid #EAE3D9;">
                    <p class="mb-2"><i class="fas fa-folder-open mr-2" style="color: #D48900; width: 16px;"></i> <strong style="color: #5C4033;">Kategori:</strong> <span id="DetailDocCategory" class="text-muted float-right font-weight-bold">-</span></p>
                    <hr style="margin: 8px 0; border-color: #EAE3D9;">
                    <p class="mb-2"><i class="fas fa-user-edit mr-2" style="color: #7F736A; width: 16px;"></i> <strong style="color: #5C4033;">Yükleyen:</strong> <span id="DetailDocUploader" class="text-muted float-right">-</span></p>
                    <hr style="margin: 8px 0; border-color: #EAE3D9;">
                    <p class="mb-0"><i class="far fa-calendar-alt mr-2" style="color: #7F736A; width: 16px;"></i> <strong style="color: #5C4033;">Tarih:</strong> <span id="DetailDocDate" class="text-muted float-right">-</span></p>
                </div>

                <div class="mt-3 p-3 text-left shadow-sm" style="background-color: #FFFFFF; border: 1px solid #EAE3D9; border-radius: 10px;">
                    <p class="mb-1 font-weight-bold" style="color: #5C4033;"><i class="fas fa-align-left mr-1"></i> Açıklama Notu:</p>
                    <p class="mb-0 text-muted" id="DetailDocDesc" style="font-size: 0.9rem; line-height: 1.5;">-</p>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 justify-content-center mt-2">
                <a href="#" id="DetailDownloadBtn" class="btn font-weight-bold px-4 shadow-sm btn-modern-download" style="border-radius: 8px;"><i class="fas fa-download mr-2"></i> Belgeyi İndir</a>
                <button type="button" class="btn btn-light font-weight-bold px-4" data-dismiss="modal" style="border-radius: 8px; border: 1px solid #EAE3D9;">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {

            $("#myDocSearch").on("keyup", function() {
                var val = $(this).val().toLowerCase();
                var hasResult = false;
                var activeFilter = $(".filter-pill.active").data("filter");

                $(".doc-item-row").each(function() {
                    var title = $(this).find(".doc-title-text").text().toLowerCase();
                    var privacy = $(this).data("privacy");

                    var matchSearch = title.indexOf(val) > -1;
                    var matchFilter = (activeFilter === "all") || (privacy === activeFilter);

                    if(matchSearch && matchFilter) {
                        $(this).show();
                        hasResult = true;
                    } else {
                        $(this).hide();
                    }
                });

                if(!hasResult && $(".doc-item-row").length > 0) {
                    $("#noResultMsg").show();
                } else {
                    $("#noResultMsg").hide();
                }
            });

            $(".filter-pill").on("click", function() {
                $(".filter-pill").removeClass("active");
                $(this).addClass("active");
                $("#myDocSearch").trigger("keyup");
            });

            $('.btn-delete-trigger').click(function () {
                var docId = $(this).data("id");
                var rowItem = $(this).closest(".doc-item-row");

                Swal.fire({
                    title: 'Dosya Silinecek!',
                    text: "Kendi yüklediğiniz bu belgeyi sistemden kalıcı olarak silmek üzeresiniz.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#C0392B',
                    cancelButtonColor: '#7F736A',
                    confirmButtonText: 'Evet, Sil!',
                    cancelButtonText: 'Vazgeç'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/Document/Delete/' + docId, type: 'POST',
                            success: function (c) {
                                if (c.success) {
                                    rowItem.fadeOut(400, function() {
                                        $(this).remove();
                                        if($(".doc-item-row").length === 0) location.reload();
                                    });
                                    Swal.fire({ toast: true, position: 'top-end', showConfirmButton: false, timer: 3000, icon: 'success', title: 'Belge silindi' });
                                }
                                else Swal.fire('Hata!', c.message, 'error');
                            }
                        });
                    }
                });
            });

            $('.btn-edit-trigger').click(function () {
                var docId = $(this).data("id");
                $.ajax({
                    url: '/Document/GetDocument/' + docId, type: 'GET',
                    success: function (c) {
                        if (c.success) {
                            $("#EditDocID").val(c.data.ID);
                            $("#EditTitle").val(c.data.Title);
                            $("#EditCategoryID").val(c.data.CategoryID);
                            $("#EditDescription").val(c.data.Description);
                            $("#EditVisibility").val(c.data.IsAdminOnly === true ? "true" : "false");
                            $("#editModal").modal('show');
                        }
                    }
                });
            });

            $("#btnUpdate").click(function () {
                var btn = $(this);
                btn.prop('disabled', true).text('Kaydediliyor...');

                var veri = {
                    id: $("#EditDocID").val(),
                    title: $("#EditTitle").val(),
                    categoryId: $("#EditCategoryID").val(),
                    description: $("#EditDescription").val(),
                    isPrivate: $("#EditVisibility").val() === "true"
                };

                $.ajax({
                    url: '/Document/Update', type: 'POST', data: veri,
                    success: function (c) {
                        if (c.success) {
                            $("#editModal").modal('hide');
                            Swal.fire('Başarılı!', 'Belge bilgileri güncellendi.', 'success').then(() => location.reload());
                        } else {
                            btn.prop('disabled', false).text('Değişiklikleri Kaydet');
                            Swal.fire('Hata!', c.message, 'error');
                        }
                    }
                });
            });

            $(document).on('click', '.btn-details-trigger', function (e) {
                e.preventDefault();
                var docId = $(this).data("id");

                $.ajax({
                    url: '/Document/GetDocument/' + docId,
                    type: 'GET',
                    success: function (cevap) {
                        if(cevap.success) {
                            var data = cevap.data;
                            $("#DetailDocTitle").text(data.Title);
                            $("#DetailDocCategory").text(data.CategoryName ? data.CategoryName : "Kategorisiz");
                            $("#DetailDocUploader").text(data.UploaderName ? data.UploaderName : "Bilinmiyor");
                            $("#DetailDocDate").text(data.UploadDate ? data.UploadDate : "-");
                            $("#DetailDocDesc").text(data.Description ? data.Description : "Bu belge için açıklama notu girilmemiş.");
                            $("#DetailDownloadBtn").attr("href", "/Document/Download/" + data.ID);

                            var ext = data.FileExtension;
                            var iconHtml = '<i class="fas fa-file fa-3x text-muted-warm"></i>';
                            if (ext === '.pdf') iconHtml = '<i class="fas fa-file-pdf fa-3x text-danger"></i>';
                            else if (ext === '.docx' || ext === '.doc') iconHtml = '<i class="fas fa-file-word fa-3x text-primary"></i>';
                            else if (ext === '.xlsx' || ext === '.xls') iconHtml = '<i class="fas fa-file-excel fa-3x text-success"></i>';
                            $("#DetailDocIcon").html(iconHtml);

                            $("#documentDetailsModal").modal('show');
                        }
                    }
                });
            });

            @if(TempData["Basari"] != null) {
                <text>Swal.fire({ toast: true, position: 'top-end', showConfirmButton: false, timer: 3000, icon: 'success', title: '@TempData["Basari"]' });</text>
            }
        });
    </script>
}