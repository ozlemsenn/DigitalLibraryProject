@{
    string userName = Session["UserName"] != null ? Session["UserName"].ToString() : "Değerli Personelimiz";
    string role = Session["Role"] != null ? Session["Role"].ToString() : "Şirket Çalışanı";
    string department = Session["Department"] != null ? Session["Department"].ToString() : "Bilinmeyen Departman";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - eLibrary Yönetim</title>

    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --wood-dark: #2C1E16;
            --wood-medium: #5C4033;
            --rust: #C0392B;
            --rust-light: #FDF3F2;
            --bg-ivory: #FCF9F5;
            --gold: #D48900;
        }

        body {
            background-color: var(--bg-ivory);
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            color: var(--wood-dark);
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        .left-sidebar {
            width: 240px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #FFFFFF;
            border-right: 1px solid rgba(0,0,0,0.05);
            padding: 20px 15px;
            z-index: 1000;
            box-shadow: 5px 0 15px rgba(0,0,0,0.01);
            display: flex;
            flex-direction: column;
        }

        .brand-logo {
            font-size: 2rem;
            font-weight: 900;
            letter-spacing: -1px;
            background: linear-gradient(to right, var(--wood-dark) 20%, var(--rust) 40%, var(--gold) 60%, var(--wood-dark) 80%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shine 4s linear infinite;
            display: flex;
            align-items: center;
            margin-bottom: 2px;
            padding-left: 5px;
            filter: drop-shadow(0px 4px 6px rgba(192,57,43,0.15));
        }

        .brand-slogan {
            font-size: 0.7rem;
            color: var(--gold);
            font-weight: 800;
            letter-spacing: 3px;
            padding-left: 42px;
            margin-top: -5px;
            margin-bottom: 35px;
            display: block;
        }

        @@keyframes shine {
            to {
                background-position: 200% center;
            }
        }

        .nav-item-custom {
            padding: 12px 15px;
            margin-bottom: 8px;
            border-radius: 12px;
            color: #7F736A;
            font-weight: 600;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            text-decoration: none;
            font-size: 0.95rem;
        }

            .nav-item-custom i {
                width: 25px;
                font-size: 1.1rem;
                transition: transform 0.3s ease;
            }

            .nav-item-custom:hover {
                background-color: var(--rust-light);
                color: var(--rust);
                text-decoration: none;
                transform: translateX(4px);
            }

            .nav-item-custom.active {
                background-color: var(--rust-light);
                color: var(--rust);
                border-left: 4px solid var(--rust);
                font-weight: 700;
            }

        .main-content {
            margin-left: 240px;
            margin-right: 260px;
            padding: 30px 25px;
            min-height: 100vh;
        }

        .top-greeting-bar {
            border-bottom: 1px solid rgba(0,0,0,0.05);
            padding-bottom: 15px;
            margin-bottom: 25px;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        .top-search-bar {
            background: #FFFFFF;
            border-radius: 12px;
            padding: 15px 25px;
            display: flex;
            align-items: center;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.03);
            margin-bottom: 30px;
            border: 1px solid #F0EAE1;
            transition: 0.3s;
        }

            .top-search-bar:focus-within {
                border-color: var(--rust);
                box-shadow: 0 5px 20px rgba(192, 57, 43, 0.08);
            }

            .top-search-bar input {
                border: none;
                outline: none;
                width: 100%;
                margin-left: 15px;
                font-size: 1rem;
                color: var(--wood-dark);
            }

        .right-panel {
            width: 260px;
            height: 100vh;
            position: fixed;
            top: 0;
            right: 0;
            background-color: #FFFFFF;
            border-left: 1px solid rgba(0,0,0,0.05);
            padding: 30px 15px;
            z-index: 1000;
            overflow-y: auto;
            box-shadow: -5px 0 15px rgba(0,0,0,0.01);
        }

        .profile-section {
            text-align: center;
            margin-bottom: 30px;
        }

        .profile-img-ring {
            width: 85px;
            height: 85px;
            border-radius: 50%;
            border: 3px solid transparent;
            background-image: linear-gradient(white, white), linear-gradient(135deg, var(--gold), var(--rust));
            background-origin: border-box;
            background-clip: content-box, border-box;
            padding: 4px;
            margin: 0 auto 15px auto;
            box-shadow: 0 8px 20px rgba(192, 57, 43, 0.15);
        }

            .profile-img-ring img {
                width: 100%;
                height: 100%;
                border-radius: 50%;
            }

        .mini-stat-card {
            background: var(--bg-ivory);
            border: 1px solid transparent;
            border-radius: 14px;
            padding: 12px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .mini-stat-card:hover {
                transform: translateY(-4px);
                background-color: #FFFFFF;
                box-shadow: 0 10px 25px rgba(192, 57, 43, 0.08);
                border: 1px solid #F0EAE1;
            }

        .mini-stat-icon {
            background: #fff;
            color: var(--rust);
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-right: 12px;
            font-size: 1.1rem;
            box-shadow: 0 4px 12px rgba(192, 57, 43, 0.15);
        }

        .btn-logout-sidebar {
            background-color: var(--rust);
            color: white;
            border-radius: 10px;
            font-weight: 600;
            padding: 12px 15px;
            transition: 0.3s;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            margin-top: auto;
            border: none;
        }

            .btn-logout-sidebar:hover {
                background-color: #9b291f;
                color: white;
                text-decoration: none;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(192, 57, 43, 0.3);
            }

        @@media (max-width: 1199px) {
            .right-panel {
                display: none !important; 
            }
            .main-content {
                margin-right: 0 !important; 
            }
        }

        @@media (max-width: 768px) {
            .left-sidebar {
                position: relative !important; 
                width: 100% !important; 
                height: auto !important; 
                border-right: none !important;
                border-bottom: 2px solid #F0EAE1;
                padding-bottom: 25px;
            }
            .main-content {
                margin-left: 0 !important; 
                padding: 20px 15px !important;
            }
            .btn-logout-sidebar {
                margin-top: 30px !important;
            }
            .top-greeting-bar {
                flex-direction: column;
                align-items: flex-start !important;
            }
            .top-greeting-bar .d-flex {
                margin-top: 15px;
            }
        }
    </style>
</head>
<body>

    <div class="left-sidebar">
        <div>
            <div class="brand-logo">
                <i class="fas fa-book-open mr-2" style="-webkit-text-fill-color: var(--rust);"></i> eLibrary
            </div>
            <span class="brand-slogan">WORKSPACE</span>


            <p style="font-size: 0.75rem; color: #a89f91; font-weight: 700; letter-spacing: 1px; margin-bottom: 10px; padding-left: 10px;">YÖNETİM PANELİ</p>

            <a href="/Admin/Index" class="nav-item-custom @(currentAction == "Index" ? "active" : "")">
                <i class="fas fa-chart-line"></i> Dashboard
            </a>
            <a href="/Admin/Documents" class="nav-item-custom @(currentAction == "Documents" ? "active" : "")">
                <i class="fas fa-file-alt"></i> Dokümanlar
            </a>
            <a href="/Admin/Categories" class="nav-item-custom @(currentAction == "Categories" ? "active" : "")">
                <i class="fas fa-folder-open"></i> Kategoriler
            </a>
            <a href="/Admin/Users" class="nav-item-custom @(currentAction == "Users" ? "active" : "")">
                <i class="fas fa-users"></i> Kullanıcılar
            </a>

            <p style="font-size: 0.75rem; color: #a89f91; font-weight: 700; letter-spacing: 1px; margin-top: 40px; margin-bottom: 10px; padding-left: 10px;">SİSTEM</p>

            <a href="/Admin/Settings" class="nav-item-custom @(currentAction == "Settings" ? "active" : "")">
                <i class="fas fa-cog"></i> Sistem Ayarları
            </a>

            <a href="/Home/ProfileSettings" class="nav-item-custom @(currentAction == "ProfileSettings" ? "active" : "")">
                <i class="fas fa-user-cog"></i> Profil Ayarları
            </a>
        </div>

        <a href="#" onclick="confirmLogout(event)" class="btn-logout-sidebar">
            <i class="fas fa-power-off mr-2"></i> Çıkış Yap
        </a>
    </div>

    <div class="main-content">

        <div class="top-greeting-bar">
            <div>
                <p class="text-muted small font-weight-bold mb-1 text-uppercase" style="letter-spacing: 1.2px;">Hoş Geldiniz</p>
                <h3 class="font-weight-bold mb-0" style="color: var(--wood-dark); letter-spacing: -0.5px;">@userName 👋</h3>
            </div>

            <div class="d-flex align-items-center">
                <span class="badge badge-light px-3 py-2 shadow-sm mr-3 d-none d-lg-block" style="color: var(--rust); border: 1px solid #F0EAE1; font-size: 0.85rem;">
                    <i class="far fa-calendar-alt mr-1"></i> @DateTime.Now.ToString("dd MMMM yyyy, dddd")
                </span>

                <div class="dropdown mx-1">
                    <button class="btn btn-sm btn-light rounded-circle shadow-sm position-relative" type="button" id="notificationDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="width: 38px; height: 38px; color: var(--wood-medium); border: 1px solid #F0EAE1; transition: 0.2s; outline: none;">
                        <i class="far fa-bell"></i>
                        <span id="notificationBadge" class="position-absolute bg-danger border border-white rounded-circle" style="width: 10px; height: 10px; top: -2px; right: -2px; display: none;"></span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-right shadow-lg border-0 mt-3" aria-labelledby="notificationDropdown" style="width: 300px; border-radius: 12px;">
                        <div class="px-3 py-2 bg-light" style="border-radius: 12px 12px 0 0; border-bottom: 1px solid #F0EAE1;">
                            <h6 class="dropdown-header font-weight-bold p-0" id="notificationCountText" style="color: var(--wood-dark); font-size: 0.85rem;">Son Sistem Bildirimleri</h6>
                        </div>

                        <div id="notificationList">
                            <div class="text-center py-4">
                                <div class="spinner-border spinner-border-sm" style="color: var(--rust);" role="status"></div>
                            </div>
                        </div>

                        <a class="dropdown-item text-center small font-weight-bold py-2 bg-light" href="/Admin/Index" style="color: var(--rust); border-radius: 0 0 12px 12px;">Tüm İşlem Geçmişi</a>
                    </div>
                </div>

                <div class="dropdown mx-1">
                    <button class="btn btn-sm btn-light rounded-circle shadow-sm position-relative" type="button" id="messageDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="width: 38px; height: 38px; color: var(--wood-medium); border: 1px solid #F0EAE1; transition: 0.2s; outline: none;">
                        <i class="far fa-envelope"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-right shadow-lg border-0 mt-3" aria-labelledby="messageDropdown" style="width: 260px; border-radius: 12px;">
                        <div class="px-3 py-3 text-center text-muted">
                            <i class="fas fa-inbox fa-2x mb-2 d-block" style="color: #EAE3D9;"></i>
                            <span style="font-size: 0.85rem;">Yeni mesajınız bulunmuyor.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="top-search-bar">
            <i class="fas fa-search" style="color: var(--rust);"></i>
            <input type="text" placeholder="Yönetim panelinde hızlı arama yapın...">
        </div>

        @RenderBody()
    </div>

    <div class="right-panel">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h6 class="font-weight-bold mb-0" style="color: var(--wood-medium);">Profiliniz</h6>
            <i class="fas fa-ellipsis-v text-muted" style="cursor: pointer; transition: 0.2s;"></i>
        </div>

        <div class="profile-section">
            <div class="profile-img-ring">
                <img src="https://ui-avatars.com/api/?name=@userName&background=D35400&color=fff&bold=true" alt="Profile">
            </div>
            <h5 class="font-weight-bold mb-1" style="color: var(--wood-dark); letter-spacing: -0.3px; font-size: 1.1rem;">@userName</h5>
            <p class="small mb-2" style="color: #7F736A;">@role</p>

            <span class="badge" style="background-color: var(--rust-light); color: var(--rust); border: 1px solid #fae3db; padding: 5px 12px; font-weight: 600; font-size: 0.75rem; border-radius: 6px;">
                <i class="fas fa-building mr-1"></i> @department
            </span>
        </div>

        <hr style="border-color: #F0EAE1; margin: 25px 0;">

        <h6 class="font-weight-bold mb-3" style="color: var(--wood-medium); font-size: 0.95rem;">Sistem Durumu</h6>

        <div class="mini-stat-card">
            <div class="mini-stat-icon"><i class="fas fa-hdd"></i></div>
            <div>
                <h6 class="mb-0 font-weight-bold" style="color: var(--wood-dark); font-size: 0.9rem;">Sunucu Alanı</h6>
                <small id="serverSpaceText" style="color: #7F736A;">Hesaplanıyor...</small>
            </div>
        </div>

        <div class="mini-stat-card">
            <div class="mini-stat-icon"><i class="fas fa-shield-alt"></i></div>
            <div>
                <h6 class="mb-0 font-weight-bold" style="color: var(--wood-dark); font-size: 0.9rem;">Güvenlik Duvarı</h6>
                <small class="font-weight-bold" style="color: #27ae60; font-size: 0.75rem;">Aktif & Güvende</small>
            </div>
        </div>

    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>

    <script>
        function confirmLogout(e) {
            e.preventDefault();
            Swal.fire({
                title: 'Çıkış Yapıyorsunuz',
                text: "Sistemden güvenli bir şekilde çıkış yapmak istediğinize emin misiniz?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#C0392B',
                cancelButtonColor: '#7F736A',
                confirmButtonText: 'Evet, Çıkış Yap',
                cancelButtonText: 'İptal',
                customClass: { popup: 'rounded-lg' }
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/Auth/Logout';
                }
            });
        }

        $(document).ready(function () {
            $.ajax({
                url: '/Admin/GetLatestNotifications',
                type: 'GET',
                success: function (res) {
                    if (res.success && res.data.length > 0) {
                        var html = '';
                        $("#notificationBadge").show();
                        $("#notificationCountText").text("Son Bildirimler (" + res.data.length + ")");

                        $.each(res.data, function (index, log) {
                            html += `
                                                <a class="dropdown-item py-3 px-3 d-flex align-items-center" href="#" style="border-bottom: 1px solid #FCF9F5; white-space: normal;">
                                                    <div class="rounded-circle d-flex align-items-center justify-content-center mr-3" style="width: 35px; height: 35px; background-color: #FDF3F2; color: var(--rust); flex-shrink: 0;">
                                                        <i class="fas ${log.IconClass}"></i>
                                                    </div>
                                                    <div style="width: 100%; overflow: hidden;">
                                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                                            <span class="font-weight-bold d-block text-truncate" style="color: var(--wood-dark); font-size: 0.85rem; max-width: 150px;">${log.ActionType}</span>
                                                            <span class="text-muted" style="font-size: 0.65rem;">${log.CreatedAt}</span>
                                                        </div>
                                                        <span class="text-muted d-block text-truncate" style="font-size: 0.75rem;" title="${log.UserName}: ${log.Description}">${log.UserName}: ${log.Description}</span>
                                                    </div>
                                                </a>`;
                        });

                        $("#notificationList").html(html);
                    } else {
                        $("#notificationList").html('<div class="px-3 py-4 text-center text-muted small"><i class="fas fa-box-open fa-2x mb-2" style="color: #EAE3D9; display:block;"></i>Yeni bildirim bulunmuyor.</div>');
                        $("#notificationBadge").hide();
                    }
                },
                error: function () {
                    $("#notificationList").html('<div class="px-3 py-3 text-center text-danger small">Bildirimler yüklenemedi.</div>');
                }
            });
        });

        $(document).ready(function () {
            $.ajax({
                url: '/Home/GetServerStatus',
                type: 'GET',
                success: function (res) {
                    if (res.success) {
                        $("#serverSpaceText").text("%" + res.yuzde + " Dolu (" + res.kullanilan + " MB)");
                    } else {
                        $("#serverSpaceText").text("Okunamadı");
                    }
                }
            });
        });
    </script>

    @RenderSection("scripts", required: false)

    @if (TempData["GeciciSifreUyarisi"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire({
                    icon: 'info',
                    title: 'Geçici Şifre Uyarısı',
                    html: '@Html.Raw(TempData["GeciciSifreUyarisi"])',
                    confirmButtonText: '<i class="fas fa-user-cog mr-1"></i> Anladım',
                    confirmButtonColor: '#D48900',
                    customClass: {
                        popup: 'rounded-lg'
                    }
                });
            });
        </script>
    }
</body>
</html>