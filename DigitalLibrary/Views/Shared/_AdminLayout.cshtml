<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - eLibrary Yönetim</title>

    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>

        :root {
            --wood-dark: #2C1E16; 
            --wood-medium: #5C4033;
            --rust: #C0392B; 
            --rust-light: #FDF3F2; 
            --bg-ivory: #FCF9F5; 
            --gold: #D48900; 
        }

        body {
            background-color: var(--bg-ivory);
            font-family: 'Segoe UI', system-ui, sans-serif;
            color: var(--wood-dark);
            overflow-x: hidden;
        }

        .left-sidebar {
            width: 260px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #FFFFFF;
            border-right: 1px solid #F0EAE1;
            padding: 20px;
            z-index: 1000;
        }

        .brand-logo {
            font-size: 1.5rem;
            font-weight: 900;
            background: linear-gradient(135deg, var(--wood-medium), var(--rust));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: flex;
            align-items: center;
            margin-bottom: 40px;
        }

        .nav-item-custom {
            padding: 12px 20px;
            margin-bottom: 8px;
            border-radius: 12px;
            color: #7F736A;
            font-weight: 600;
            transition: 0.3s ease;
            display: flex;
            align-items: center;
            text-decoration: none;
        }

            .nav-item-custom i {
                width: 25px;
                font-size: 1.1rem;
            }

            .nav-item-custom:hover {
                background-color: var(--rust-light);
                color: var(--rust);
                text-decoration: none;
            }

            .nav-item-custom.active {
                background-color: var(--rust-light);
                color: var(--rust);
                border-left: 4px solid var(--rust);
            }

        .main-content {
            margin-left: 260px;
            margin-right: 320px; 
            padding: 30px 40px;
            min-height: 100vh;
        }

        .top-search-bar {
            background: #FFFFFF;
            border-radius: 50px;
            padding: 12px 25px;
            display: flex;
            align-items: center;
            box-shadow: 0 4px 15px rgba(92, 64, 51, 0.03);
            margin-bottom: 30px;
            border: 1px solid #F0EAE1;
        }

            .top-search-bar input {
                border: none;
                outline: none;
                width: 100%;
                margin-left: 15px;
                font-size: 0.95rem;
                color: var(--wood-dark);
            }

        .right-panel {
            width: 320px;
            height: 100vh;
            position: fixed;
            top: 0;
            right: 0;
            background-color: #FFFFFF;
            border-left: 1px solid #F0EAE1;
            padding: 30px 20px;
            z-index: 1000;
            overflow-y: auto;
        }

        .profile-section {
            text-align: center;
            margin-bottom: 30px;
        }

        .profile-img-ring {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            border: 3px solid var(--rust);
            padding: 4px;
            margin: 0 auto 15px auto;
        }

            .profile-img-ring img {
                width: 100%;
                height: 100%;
                border-radius: 50%;
            }

        .mini-stat-card {
            background: var(--bg-ivory);
            border: 1px solid #F0EAE1;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            transition: 0.3s ease;
        }

            .mini-stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 5px 15px rgba(192, 57, 43, 0.08);
            }

        .mini-stat-icon {
            background: #fff;
            color: var(--rust);
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-right: 15px;
            font-size: 1.2rem;
            box-shadow: 0 4px 10px rgba(192, 57, 43, 0.1);
        }
    </style>
</head>
<body>

    <div class="left-sidebar">
        <div class="brand-logo">
            <i class="fas fa-book-open mr-2" style="color: #C0392B;"></i> eLibrary
        </div>

        @{ 
            var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        }

        <p style="font-size: 0.75rem; color: #a89f91; font-weight: 700; letter-spacing: 1px; margin-bottom: 10px; padding-left: 10px;">YÖNETİM PANELİ</p>

        <a href="/Admin/Index" class="nav-item-custom @(currentAction == "Index" ? "active" : "")">
            <i class="fas fa-chart-line"></i> Dashboard
        </a>
        <a href="/Admin/Documents" class="nav-item-custom @(currentAction == "Documents" ? "active" : "")">
            <i class="fas fa-file-alt"></i> Dokümanlar
        </a>
        <a href="/Admin/Categories" class="nav-item-custom @(currentAction == "Categories" ? "active" : "")">
            <i class="fas fa-folder-open"></i> Kategoriler
        </a>
        <a href="/Admin/Users" class="nav-item-custom @(currentAction == "Users" ? "active" : "")">
            <i class="fas fa-users"></i> Kullanıcılar
        </a>

        <p style="font-size: 0.75rem; color: #a89f91; font-weight: 700; letter-spacing: 1px; margin-top: 40px; margin-bottom: 10px; padding-left: 10px;">GÜVENLİK</p>

        <a href="#" class="nav-item-custom">
            <i class="fas fa-cog"></i> Sistem Ayarları
        </a>
        <a href="/Home/Index" class="nav-item-custom text-danger mt-5">
            <i class="fas fa-sign-out-alt"></i> Personel Ekranına Dön
        </a>
    </div>

    <div class="main-content">
        <div class="top-search-bar">
            <i class="fas fa-search" style="color: var(--rust);"></i>
            <input type="text" placeholder="Yönetim panelinde hızlı arama yapın...">
        </div>

        @RenderBody()
    </div>

    <div class="right-panel">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h6 class="font-weight-bold mb-0" style="color: var(--wood-medium);">Profiliniz</h6>
            <i class="fas fa-ellipsis-v text-muted" style="cursor: pointer;"></i>
        </div>

        <div class="profile-section">
            <div class="profile-img-ring">
                <img src="https://ui-avatars.com/api/?name=Admin&background=C0392B&color=fff&bold=true" alt="Profile">
            </div>
            <h5 class="font-weight-bold mb-1" style="color: var(--wood-dark);">Yönetici</h5>
            <p class="small mb-3" style="color: #7F736A;">IT Departmanı</p>

            <div class="d-flex justify-content-center">
                <button class="btn btn-sm btn-light rounded-circle shadow-sm mx-1" style="width: 35px; height: 35px; color: var(--wood-medium); border: 1px solid #F0EAE1;"><i class="far fa-bell"></i></button>
                <button class="btn btn-sm btn-light rounded-circle shadow-sm mx-1" style="width: 35px; height: 35px; color: var(--wood-medium); border: 1px solid #F0EAE1;"><i class="far fa-envelope"></i></button>
            </div>
        </div>

        <hr style="border-color: #F0EAE1; margin: 30px 0;">

        <h6 class="font-weight-bold mb-3" style="color: var(--wood-medium);">Sistem Durumu</h6>

        <div class="mini-stat-card">
            <div class="mini-stat-icon"><i class="fas fa-hdd"></i></div>
            <div>
                <h6 class="mb-0 font-weight-bold" style="color: var(--wood-dark);">Sunucu Alanı</h6>
                <small style="color: #7F736A;">%45 Dolu</small>
            </div>
        </div>

        <div class="mini-stat-card">
            <div class="mini-stat-icon"><i class="fas fa-shield-alt"></i></div>
            <div>
                <h6 class="mb-0 font-weight-bold" style="color: var(--wood-dark);">Güvenlik</h6>
                <small class="font-weight-bold" style="color: #27ae60;">Aktif & Güvende</small>
            </div>
        </div>

    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>